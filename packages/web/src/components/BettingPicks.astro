---
import type { AiEvaluation, BetHitStatus, BettingPicks, RaceRacer } from "@fun-site/shared";
import {
  BOAT_COLORS,
  bettingBasisFor,
  bettingStyleFor,
  bettingToleranceFor,
  computeBettingPicks,
  computeOneMarkDistances,
  isValidBoatNumber,
  oneMarkDistanceOptionsFor,
} from "@fun-site/shared";

interface Props {
  racers: readonly RaceRacer[];
  /**
   * バッチが採点した買い目。渡された場合はこちらを描画し、
   * 内部での再計算はしない。穴予想 (`bettingStyle="suji"` の v9_suji /
   * `"kimarite"` の v10_kimarite) は CSV 由来の出目なので web からは
   * 再計算できず、これが必須になる。
   */
  dailyPicks?: BettingPicks;
  realtimePicks?: BettingPicks;
  /** 買い目 1 点ごとの決まり手注釈 (穴予想のみ)。picks と同順。 */
  dailyKimarite?: readonly string[];
  realtimeKimarite?: readonly string[];
  /** 朝バッチ時点の AI 評価 (= 当日買い目の根拠)。無ければ当日買い目は表示されない。 */
  aiEvaluationDaily?: AiEvaluation;
  /** 直前情報反映後の AI 評価 (= 直前買い目の根拠)。無ければ直前買い目は「未取得」と表示する。 */
  aiEvaluationRealtime?: AiEvaluation;
  /** 後方互換: いずれの個別評価も渡されていない場合のフォールバック。
   *  state によって当日買い目 / 直前買い目 を切り替える。 */
  aiEvaluation?: AiEvaluation;
  /** 結果確定後の的中状況。未指定なら的中バッジは表示しない。 */
  hitStatus?: BetHitStatus;
  /** 見出しの先頭に付ける予想者名（例: "本命予想"）。未指定なら付けない。 */
  predictorName?: string;
  /** 買い目しきい値を予想者ごとに切り替えるための ID。未指定なら既定の ±0.10。 */
  predictorId?: string;
}

const {
  racers,
  dailyPicks,
  realtimePicks,
  dailyKimarite,
  realtimeKimarite,
  aiEvaluationDaily,
  aiEvaluationRealtime,
  aiEvaluation,
  hitStatus,
  predictorName,
  predictorId,
} = Astro.props;

const tolerance = bettingToleranceFor(predictorId);

/** 予測 ST の種別（AI 推定 ST / 全国平均 ST）。バッチ側の買い目生成
 *  (`prediction-builder.ts`) と同じヘルパーで解決し、表示される買い目と
 *  的中・回収率の集計対象になる買い目を一致させる。 */
const stOptions = oneMarkDistanceOptionsFor(predictorId);

/** 買い目候補の選定基準。strengthOnlyBetting な予想者 (v8_aionly) は走行距離
 *  ではなく強さpt のみで選定する。バッチ側と同じヘルパーで解決する。 */
const basis = bettingBasisFor(predictorId);

/** 買い目の作り方。"formation" 以外 (v9_suji / v10_kimarite) は 1 マーク走行距離を使わない。 */
const style = bettingStyleFor(predictorId);

/** しきい値の説明文。全着順同値なら "±X"、異なれば着順別に列挙。 */
const toleranceLabel =
  tolerance.first === tolerance.second && tolerance.second === tolerance.third
    ? `±${tolerance.first}`
    : `1着 ±${tolerance.first} / 2着 ±${tolerance.second} / 3着 ±${tolerance.third}`;

/** 見出し: "{shortName}当日買い目" / "{shortName}直前買い目"。
 *  predictorName 末尾の「予想」サフィックスは除去する ("本命予想" → "本命")。
 *  predictorName 省略時はプレフィクス無し。 */
const headingPrefix = predictorName ? predictorName.replace(/予想$/, "") : "";

// 後方互換: aiEvaluation 単体が渡された場合は state を見て daily / realtime のどちらかに振り分ける
const dailyEval =
  aiEvaluationDaily ??
  (aiEvaluation && aiEvaluation.state === "daily" ? aiEvaluation : undefined);
const realtimeEval =
  aiEvaluationRealtime ??
  (aiEvaluation && aiEvaluation.state === "realtime" ? aiEvaluation : undefined);

type Group = { readonly label: string; readonly boats: readonly number[] };
/** 出目リスト型の 1 点 (出目 + 決まり手注釈)。 */
type ComboRow = { readonly boats: readonly number[]; readonly kimarite: string };

const toGroups = (picks: BettingPicks): Group[] | null =>
  picks.kind === "formation"
    ? [
        { label: "1着", boats: picks.first },
        { label: "2着", boats: picks.second },
        { label: "3着", boats: picks.third },
      ]
    : null;

const toCombos = (
  picks: BettingPicks | undefined,
  kimarite: readonly string[] | undefined,
): ComboRow[] | null =>
  picks && picks.kind === "combos"
    ? picks.combos.map((c, i) => ({ boats: [...c], kimarite: kimarite?.[i] ?? "" }))
    : null;

/** バッチ由来の買い目があればそれを、無ければ従来どおり内部で計算する。 */
const resolvePicks = (
  given: BettingPicks | undefined,
  evaluation: AiEvaluation | undefined,
): BettingPicks | null => {
  if (given) return given;
  if (!evaluation) return null;
  return computeBettingPicks(computeOneMarkDistances(racers, evaluation, stOptions), tolerance, basis);
};

type SectionKind = "daily" | "realtime";

const dailyResolved = resolvePicks(dailyPicks, dailyEval);
const realtimeResolved = resolvePicks(realtimePicks, realtimeEval);

const sections: {
  readonly kind: SectionKind;
  readonly heading: string;
  readonly groups: Group[] | null;
  readonly combos: ComboRow[] | null;
}[] = [
  {
    kind: "daily",
    heading: `${headingPrefix}当日買い目`,
    groups: dailyResolved ? toGroups(dailyResolved) : null,
    combos: toCombos(dailyPicks, dailyKimarite),
  },
  {
    kind: "realtime",
    heading: `${headingPrefix}直前買い目`,
    groups: realtimeResolved ? toGroups(realtimeResolved) : null,
    combos: toCombos(realtimePicks, realtimeKimarite),
  },
];

const isSectionHit = (kind: SectionKind): boolean => {
  if (!hitStatus) return false;
  return kind === "daily" ? hitStatus.dailyHit : hitStatus.realtimeHit;
};

/** 当日 = 🎯 + amber, 直前 = 🔥 + cyan で識別する */
const hitBadgeClass = (kind: SectionKind): string =>
  kind === "daily"
    ? "inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300"
    : "inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-cyan-100 text-cyan-800 border border-cyan-300";

const hitBadgeIcon = (kind: SectionKind): string => (kind === "daily" ? "🎯" : "🔥");

const boatBoxStyle = (boatNumber: number): string => {
  const color = isValidBoatNumber(boatNumber) ? BOAT_COLORS[boatNumber] : undefined;
  const bg = color?.hex ?? "#999";
  const fg = color?.textHex ?? "#fff";
  // 1号艇 (白) は視認性確保のため細いボーダーを付ける
  const border = boatNumber === 1 ? " border: 1px solid #cbd5e1;" : "";
  return `background-color: ${bg}; color: ${fg};${border}`;
};
---

<div class="space-y-4">
  {sections.map((section) => (
    <div>
      <h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
        <span>{section.heading}</span>
        {isSectionHit(section.kind) && (
          <span class={hitBadgeClass(section.kind)} aria-label={`${section.heading}が的中`}>
            <span aria-hidden="true">{hitBadgeIcon(section.kind)}</span>
            <span>的中</span>
          </span>
        )}
      </h3>
      {section.combos !== null ? (
        <ul class="space-y-1">
          {section.combos.map((row) => (
            <li class="flex items-center gap-2">
              <span class="flex items-center gap-1">
                {row.boats.map((bn, bi) => (
                  <>
                    {bi > 0 && (
                      <span class="text-gray-400 text-sm font-bold" aria-hidden="true">-</span>
                    )}
                    <span
                      class="inline-flex items-center justify-center w-7 h-7 rounded text-sm font-bold"
                      style={boatBoxStyle(bn)}
                    >
                      {bn}
                    </span>
                  </>
                ))}
              </span>
              {row.kimarite && (
                <span class="text-xs text-gray-500">{row.kimarite}</span>
              )}
            </li>
          ))}
        </ul>
      ) : section.groups === null ? (
        <p class="text-xs text-gray-400">
          {section.kind === "realtime"
            ? "直前情報がまだ反映されていません。"
            : "当日の AI 評価が取得できていません。"}
        </p>
      ) : (
        <div class="flex flex-wrap items-center gap-2">
          {section.groups.map((group, gi) => (
            <>
              {gi > 0 && (
                <span class="text-gray-500 text-xl font-bold mx-0.5" aria-hidden="true">−</span>
              )}
              <div
                class="flex items-center gap-1.5"
                aria-label={`${section.heading} ${group.label}候補`}
              >
                {group.boats.length === 0 ? (
                  <span class="text-xs text-gray-400">該当なし</span>
                ) : (
                  group.boats.map((bn) => (
                    <span
                      class="inline-flex items-center justify-center w-8 h-8 rounded-md text-base font-bold"
                      style={boatBoxStyle(bn)}
                      title={`${section.heading} ${group.label}候補: ${bn}号艇`}
                    >
                      {bn}
                    </span>
                  ))
                )}
              </div>
            </>
          ))}
        </div>
      )}
    </div>
  ))}
</div>
<p class="text-xs text-gray-500 mt-3">
  {style === "suji" ? (
    <>1コース以外で強さptが最大の艇を1着に固定し、スジ表 P(2着, 3着 | 1着) の上位 5 ペアを組み合わせた 5 点です（フォーメーションではなく出目そのもの）。1マーク予想の走行距離は買い目の選定に使いません。</>
  ) : style === "kimarite" ? (
    <>決まり手 × 1着コースの確率表から組み立てた上位 5 点です（フォーメーションではなく出目そのもの）。1マーク予想の走行距離は買い目の選定に使いません。</>
  ) : basis === "strength" ? (
    <>AI 総合評価の強さポイントを基準に、各着順の上位艇から {toleranceLabel}pt 以内の艇を候補としています（三連単フォーメーションの目安）。予測STは買い目の選定に使いません。</>
  ) : (
    <>1マーク予想の走行距離を基準に、各着順の上位艇から {toleranceLabel} 以内の艇を候補としています（三連単フォーメーションの目安）。
    走行距離の予測STは{stOptions.useEstimatedST ? "実測ST履歴から算出したAI推定ST" : "選手の全国平均ST"}です。</>
  )}
  「当日買い目」は朝バッチ時点（直前情報反映前）、「直前買い目」は直前情報反映後の AI 評価に基づきます。
</p>
