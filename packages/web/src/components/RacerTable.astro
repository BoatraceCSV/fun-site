---
import type { RaceRacer } from "@fun-site/shared";
import { BOAT_COLORS, getStadiumById, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  racers: readonly RaceRacer[];
  /** 開催場 ID。支部が地元かどうかの判定に使う */
  stadiumId: string;
}

const { racers, stadiumId } = Astro.props;
const sorted = [...racers].sort((a, b) => a.boatNumber - b.boatNumber);

const rankColor = (rank: string): string => {
  if (rank === "A1") return "text-red-600";
  if (rank === "A2") return "text-orange-500";
  if (rank === "B1") return "text-gray-700";
  return "text-gray-500";
};

/**
 * 支部は「兵庫」「東京」のように接尾辞なしで入る一方、会場マスタは「兵庫県」
 * 「東京都」なので、会場側の接尾辞を落として突き合わせる（北海道は例外）。
 */
const prefecture = getStadiumById(stadiumId)?.prefecture ?? "";
const localBranch = prefecture === "北海道" ? prefecture : prefecture.replace(/[都府県]$/, "");
const isLocal = (branch: string): boolean => branch !== "" && branch === localBranch;

/**
 * 比較用のセル強調。項目ごとに **1 位と 2 位の値** を求め、その値を持つセルの
 * 背景色を変える（同値は同順なので 3 艇以上が塗られることもある）。
 * 0 は未計測（データ無し）なので順位付けの対象外。
 */
type TopTwo = { first: number | undefined; second: number | undefined };

const topTwo = (values: readonly number[], order: "asc" | "desc"): TopTwo => {
  const uniq = [...new Set(values.filter((v) => v > 0))].sort((a, b) =>
    order === "asc" ? a - b : b - a,
  );
  return { first: uniq[0], second: uniq[1] };
};

const avgStTop = topTwo(
  sorted.map((r) => r.nationalAvgST),
  "asc",
);
const nationalWinTop = topTwo(
  sorted.map((r) => r.nationalWinRate),
  "desc",
);
const localWinTop = topTwo(
  sorted.map((r) => r.localWinRate),
  "desc",
);
const motorTop = topTwo(
  sorted.map((r) => r.motorTop3Rate),
  "desc",
);

const highlight = (value: number, top: TopTwo): string => {
  if (value <= 0) return "";
  if (value === top.first) return "bg-amber-200 text-amber-900 font-bold";
  if (value === top.second) return "bg-amber-100 text-amber-800";
  return "";
};

/** 0（未計測）は "—" */
const num = (v: number, digits: number): string => (v > 0 ? v.toFixed(digits) : "—");
---

{/*
  基本情報は 6 列 × 6 艇の <table>。カード（1 艇 = 1 カード）だと項目が縦に散って
  艇どうしの比較ができないため、比較したい 4 指標（平均ST / 全国勝率 / 当地勝率 /
  モーター3連率）を同じ列に落としている。列数を 6 に絞ることで iPhone 幅
  (375px) でも横スクロールなしで収まる。今節成績は別表 (SessionResultsTable)。
*/}
<div class="space-y-3">
  <div class="overflow-x-auto">
    <table class="w-full text-[11px] border-collapse">
      <thead>
        <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
          <th scope="col" class="text-left py-1 px-0.5 font-medium">枠</th>
          <th scope="col" class="text-left py-1 px-0.5 font-medium">選手</th>
          <th scope="col" class="text-right py-1 px-0.5 font-medium">平均ST</th>
          <th scope="col" class="text-right py-1 px-0.5 font-medium">全国<br />勝率</th>
          <th scope="col" class="text-right py-1 px-0.5 font-medium">当地<br />勝率</th>
          <th scope="col" class="text-right py-1 px-0.5 font-medium">モーター<br />3連率</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((racer) => {
          const color = isValidBoatNumber(racer.boatNumber)
            ? BOAT_COLORS[racer.boatNumber]
            : undefined;
          return (
            <tr class="border-b border-gray-100">
              <td class="py-1 px-0.5 align-top">
                <span
                  class="inline-flex items-center justify-center w-4 h-4 rounded text-[10px] font-bold"
                  style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                >
                  {racer.boatNumber}
                </span>
              </td>
              <td class="py-1 px-0.5 align-top">
                <div class="flex items-center gap-1 flex-wrap text-[12px] font-medium leading-tight">
                  <span>{racer.racerName}</span>
                  {racer.flyingCount > 0 && (
                    <span
                      class="inline-block px-1 py-0.5 rounded text-[9px] font-bold leading-none bg-red-100 text-red-700"
                      title={`フライング ${racer.flyingCount} 本`}
                    >
                      F{racer.flyingCount}
                    </span>
                  )}
                  {racer.lateCount > 0 && (
                    <span
                      class="inline-block px-1 py-0.5 rounded text-[9px] font-bold leading-none bg-amber-100 text-amber-800"
                      title={`出遅れ ${racer.lateCount} 本`}
                    >
                      L{racer.lateCount}
                    </span>
                  )}
                  {racer.prizeExcluded && (
                    <span
                      class="inline-block px-1 py-0.5 rounded text-[9px] font-bold leading-none bg-gray-200 text-gray-600"
                      title="賞金除外（補欠出走等）"
                    >
                      賞除
                    </span>
                  )}
                </div>
                <div class="text-[10px] text-gray-500 leading-tight">
                  <span class={`font-semibold ${rankColor(racer.classGrade)}`}>
                    {racer.classGrade}
                  </span>
                  {racer.age > 0 && <span class="ml-1">{racer.age}歳</span>}
                  {racer.branch && (
                    <span
                      class={`ml-1 ${isLocal(racer.branch) ? "text-emerald-600 font-bold" : ""}`}
                      title={isLocal(racer.branch) ? "地元支部" : undefined}
                    >
                      {racer.branch}
                    </span>
                  )}
                </div>
              </td>
              <td
                class={`py-1 px-0.5 text-right align-top tabular-nums font-mono text-gray-800 ${highlight(racer.nationalAvgST, avgStTop)}`}
              >
                {num(racer.nationalAvgST, 2)}
              </td>
              <td
                class={`py-1 px-0.5 text-right align-top tabular-nums font-mono text-gray-800 ${highlight(racer.nationalWinRate, nationalWinTop)}`}
              >
                {num(racer.nationalWinRate, 2)}
              </td>
              <td
                class={`py-1 px-0.5 text-right align-top tabular-nums font-mono text-gray-800 ${highlight(racer.localWinRate, localWinTop)}`}
              >
                {num(racer.localWinRate, 2)}
              </td>
              <td
                class={`py-1 px-0.5 text-right align-top tabular-nums font-mono text-gray-800 ${highlight(racer.motorTop3Rate, motorTop)}`}
              >
                {num(racer.motorTop3Rate, 1)}
                <span class="block text-[9px] font-normal text-gray-400">
                  #{racer.motorNumber}
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="text-[11px] text-gray-400">
    平均ST・全国勝率・当地勝率・モーター3連対率は、
    <span class="inline-block px-1 rounded bg-amber-200 text-amber-900 font-bold">1位</span>
    と
    <span class="inline-block px-1 rounded bg-amber-100 text-amber-800">2位</span>
    を背景色で示しています（平均STは小さいほど上位、同値は同順）。 支部が
    <span class="text-emerald-600 font-bold">緑色</span>の選手は地元支部（
    {localBranch || "—"}）です。モーター欄の
    <span class="font-mono">#</span>はモーター番号。
  </p>
</div>
