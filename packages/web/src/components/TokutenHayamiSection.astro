---
import type { RaceTokutenHayami, TokutenHayamiRacer } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  tokutenHayami: RaceTokutenHayami;
}

const { tokutenHayami } = Astro.props;
const racers = [...tokutenHayami.racers].sort((a, b) => a.boatNumber - b.boatNumber);

/** 着順点の表示（"1着 10点 / 2着 8点 …"） */
const pointsLabel = tokutenHayami.rankPoints
  .map((p, i) => (p === null ? null : `${i + 1}着 ${p}点`))
  .filter((v): v is string => v !== null)
  .join(" ・ ");

/** 得点率セル。数値でない場合（賞除 / 欠場 / 帰郷 / 追配）はラベルをそのまま出す */
const scoreRateText = (racer: TokutenHayamiRacer): string =>
  racer.scoreRate !== null ? racer.scoreRate.toFixed(2) : racer.scoreRateLabel || "—";

/**
 * 「この着ならこうなる」セルの強調。上流の状態コードは bit で意味を持つ:
 * bit1 = ボーダー得点率以上 / bit2 = 次レース次第 / bit4 = 当レース終了時点でボーダー以上。
 * 当レース終了時点で確定的にボーダー以上のセルを最も強く出す。
 */
const ifRankClass = (status: number | null): string => {
  if (status === null || status === 0) return "text-gray-500";
  if ((status & 4) !== 0) return "bg-amber-100 text-amber-900 font-bold rounded";
  if ((status & 2) !== 0) return "bg-amber-50 text-amber-800 rounded";
  if ((status & 1) !== 0) return "text-amber-800 font-medium";
  return "text-gray-500";
};
---

<div class="space-y-3">
  <div class="overflow-x-auto">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="border-b border-gray-200 text-gray-500 text-[11px]">
          <th class="text-left py-1 px-1 font-medium">枠</th>
          <th class="text-left py-1 px-1 font-medium">選手</th>
          <th class="text-right py-1 px-1 font-medium">得点率</th>
          <th class="text-right py-1 px-1 font-medium">順位</th>
          {[1, 2, 3, 4, 5, 6].map((k) => (
            <th class="text-right py-1 px-1 font-medium tabular-nums">{k}着</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {racers.map((racer) => {
          const color = isValidBoatNumber(racer.boatNumber)
            ? BOAT_COLORS[racer.boatNumber]
            : undefined;
          return (
            <tr class="border-b border-gray-100">
              <td class="py-1.5 px-1">
                <span
                  class="inline-flex items-center justify-center w-5 h-5 rounded text-[11px] font-bold"
                  style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                >
                  {racer.boatNumber}
                </span>
              </td>
              <td class="py-1.5 px-1">
                <span class="whitespace-nowrap">{racer.racerName}</span>
                {racer.classGrade && (
                  <span class="ml-1 text-[10px] text-gray-400">{racer.classGrade}</span>
                )}
                {racer.otherRaceNumber !== null && (
                  <span class="ml-1 text-[10px] text-gray-400">
                    (本日{racer.otherRaceNumber}Rも出走)
                  </span>
                )}
              </td>
              <td
                class={`py-1.5 px-1 text-right tabular-nums font-bold ${
                  racer.withinBorder ? "text-amber-700" : "text-gray-800"
                }`}
              >
                {scoreRateText(racer)}
              </td>
              <td
                class={`py-1.5 px-1 text-right tabular-nums ${
                  racer.withinBorder ? "text-amber-700 font-bold" : "text-gray-600"
                }`}
              >
                {racer.rank !== null ? racer.rank : "—"}
              </td>
              {racer.ifRanks.map((cell) => (
                <td class="py-1.5 px-0.5 text-right tabular-nums">
                  <span class={`inline-block px-1 py-0.5 text-[11px] ${ifRankClass(cell.status)}`}>
                    {cell.scoreRate !== null ? cell.scoreRate.toFixed(2) : "—"}
                  </span>
                </td>
              ))}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="text-[11px] text-gray-400 space-y-1">
    <p>
      得点率は着順点の平均（得点の合計 ÷ 出走数）。「1着」〜「6着」欄は<strong class="font-medium"
        >このレースでその着順を取った場合の得点率</strong
      >です。
      {pointsLabel && <span>このレースの着順点は {pointsLabel}。</span>}
    </p>
    <p>
      {tokutenHayami.borderRank !== null ? (
        <>
          橙色は準優進出ボーダー（上位 {tokutenHayami.borderRank} 名）以上を示します。
        </>
      ) : (
        <>橙色は準優進出ボーダー以上を示します。</>
      )}
      濃い橙のセルは当レース終了時点でボーダー以上、薄い橙は次レースの結果次第でボーダー以上の可能性があることを表します。
    </p>
    <p>得点率早見は予選最終日までの表示です。</p>
  </div>
</div>
