---
import type { RaceResultCourse } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";
import {
  BADGE_SIZE,
  BADGE_X,
  BOAT_HEIGHT_PX,
  BOAT_LENGTH_SEC,
  FIGURE_BG,
  LANE_HEIGHT,
  LANE_LINE,
  LANES,
  RIGHT_PAD,
  ST_MAX,
  ST_MIN,
  ST_TICKS,
  START_LINE_X,
  TOP_PAD,
  TRACK_LEFT,
  TRACK_RIGHT,
  TRACK_W,
  VIEWBOX_H,
  VIEWBOX_W,
  WATER_FILL,
  boatCanopyX,
  boatHullPath,
  clampBowX,
  stToX,
} from "../lib/start-diagram";

interface Props {
  /** 確定結果の進入コース別 ST / F。並び順は問わない（内部でコース昇順にする）。 */
  courses: readonly RaceResultCourse[];
}

const { courses } = Astro.props;

const sortedCourses = [...courses].sort((a, b) => a.courseNumber - b.courseNumber);

/**
 * ST 未取得（欠場・エンスト等で CSV が空 → 0）の判定。
 * 結果テーブルの `c.startTiming ? … : "—"` と同じ扱いに揃えている。
 */
const hasSt = (c: RaceResultCourse): boolean => c.startTiming !== 0;

/**
 * ST ラベル。フライングは負の符号を出さず `F.03` 表記にする
 * （SessionResultsGrid / 出走表の今節成績と同じ書き方）。
 */
const stLabel = (c: RaceResultCourse): string =>
  c.flying ? `F${Math.abs(c.startTiming).toFixed(2).slice(1)}` : c.startTiming.toFixed(2);

const hasMissingSt = sortedCourses.some((c) => !hasSt(c));
const hasFlying = sortedCourses.some((c) => c.flying);
/** 表示レンジ外の艇。舳先は端で止まるので、数値ラベルが正なことを注記で断る。 */
const hasClamped = sortedCourses.some(
  (c) => hasSt(c) && (c.startTiming < ST_MIN || c.startTiming > ST_MAX),
);
---

<figure class="rounded-lg overflow-hidden border border-blue-100">
  <svg
    viewBox={`0 0 ${VIEWBOX_W} ${VIEWBOX_H}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="スタート結果図（進入順）"
    class="w-full h-auto"
  >
    <rect x="0" y="0" width={VIEWBOX_W} height={VIEWBOX_H} fill={FIGURE_BG} />

    {/* 水面背景 */}
    <rect x={TRACK_LEFT} y={TOP_PAD} width={TRACK_W} height={LANE_HEIGHT * LANES} fill={WATER_FILL} />

    {/* レーン区切り */}
    {Array.from({ length: LANES + 1 }).map((_, i) => {
      const y = TOP_PAD + i * LANE_HEIGHT;
      return <line x1={TRACK_LEFT} y1={y} x2={TRACK_RIGHT} y2={y} stroke={LANE_LINE} stroke-width="1" />;
    })}

    {/*
      艇。舳先を ST の位置に置き、船尾へ 1 艇身 (0.135 秒) ぶん伸ばす。
      船尾が水面左端をはみ出すぶんは、この後のカーテン矩形で隠す。
      ST 未取得 (欠場・エンスト等) の艇は位置が決まらないので水面には出さない
      （左の艇番バッジと右の "—" でその艇の存在は分かる）。
    */}
    {sortedCourses.filter(hasSt).map((c) => {
      const i = sortedCourses.indexOf(c);
      const cy = TOP_PAD + i * LANE_HEIGHT + LANE_HEIGHT / 2;
      const color = isValidBoatNumber(c.boatNumber) ? BOAT_COLORS[c.boatNumber] : undefined;
      const fill = color?.hex ?? "#cbd5e1";
      // フライングは艇を赤縁で強調する。1号艇は艇色が白なので通常時も縁を付ける。
      const stroke = c.flying ? "#dc2626" : c.boatNumber === 1 ? "#94a3b8" : fill;
      const textColor = color?.textHex ?? "#0f172a";
      const bowX = clampBowX(stToX(c.startTiming));
      return (
        <g>
          <path
            d={boatHullPath(bowX, cy)}
            fill={fill}
            stroke={stroke}
            stroke-width={c.flying ? 2.5 : 1.2}
            stroke-linejoin="round"
          />
          {/* コックピット。艇の向き（右が進行方向）を分かりやすくする */}
          <ellipse
            cx={boatCanopyX(bowX)}
            cy={cy}
            rx={BOAT_HEIGHT_PX * 0.42}
            ry={BOAT_HEIGHT_PX * 0.26}
            fill={textColor}
            opacity="0.28"
          />
        </g>
      );
    })}

    {/* 水面外にはみ出した艇を隠すカーテン。以降のラベルはこの上に描く */}
    <rect x="0" y="0" width={TRACK_LEFT} height={VIEWBOX_H} fill={FIGURE_BG} />
    <rect x={TRACK_RIGHT} y="0" width={RIGHT_PAD} height={VIEWBOX_H} fill={FIGURE_BG} />

    {/* スタートライン（赤、太線）。艇に隠れないよう艇の後に描く */}
    <line
      x1={START_LINE_X}
      y1={TOP_PAD}
      x2={START_LINE_X}
      y2={TOP_PAD + LANE_HEIGHT * LANES}
      stroke="#dc2626"
      stroke-width="2.5"
    />
    <text
      x={START_LINE_X}
      y={TOP_PAD - 8}
      text-anchor="middle"
      font-size="11"
      fill="#dc2626"
      font-weight="600"
    >
      スタートライン
    </text>

    {/* ST 目盛り */}
    {ST_TICKS.map((tv) => {
      const x = stToX(tv);
      return (
        <g>
          <line
            x1={x}
            y1={TOP_PAD + LANE_HEIGHT * LANES}
            x2={x}
            y2={TOP_PAD + LANE_HEIGHT * LANES + 4}
            stroke="#94a3b8"
            stroke-width="1"
          />
          <text
            x={x}
            y={TOP_PAD + LANE_HEIGHT * LANES + 16}
            text-anchor="middle"
            font-size="10"
            fill="#64748b"
          >
            {tv.toFixed(2)}
          </text>
        </g>
      );
    })}
    <text
      x={(TRACK_LEFT + TRACK_RIGHT) / 2}
      y={VIEWBOX_H - 6}
      text-anchor="middle"
      font-size="10"
      fill="#64748b"
    >
      スタートタイミング(秒)
    </text>

    {/* 艇番バッジ・コース番号・ST 値 */}
    {sortedCourses.map((c, i) => {
      const cy = TOP_PAD + i * LANE_HEIGHT + LANE_HEIGHT / 2;
      const color = isValidBoatNumber(c.boatNumber) ? BOAT_COLORS[c.boatNumber] : undefined;
      return (
        <g>
          {/* 艇番。艇体は ST が遅いほど水面外へ出るので番号はここに固定で出す */}
          <rect
            x={BADGE_X}
            y={cy - BADGE_SIZE / 2}
            width={BADGE_SIZE}
            height={BADGE_SIZE}
            rx="3"
            fill={color?.hex ?? "#cbd5e1"}
            stroke="#94a3b8"
            stroke-width={c.boatNumber === 1 ? 1 : 0}
          />
          <text
            x={BADGE_X + BADGE_SIZE / 2}
            y={cy + 4}
            text-anchor="middle"
            font-size="12"
            font-weight="700"
            fill={color?.textHex ?? "#0f172a"}
          >
            {c.boatNumber}
          </text>
          <text
            x={TRACK_LEFT - 10}
            y={cy + 4}
            text-anchor="end"
            font-size="12"
            fill="#1e3a8a"
            font-weight="700"
          >
            {c.courseNumber}コース
          </text>
          <text
            x={TRACK_RIGHT + 8}
            y={cy + 4}
            font-size="13"
            fill={c.flying ? "#dc2626" : "#0f172a"}
            font-weight={c.flying ? 700 : 400}
            font-family="monospace"
          >
            {hasSt(c) ? stLabel(c) : "—"}
          </text>
        </g>
      );
    })}
  </svg>
  <figcaption class="text-xs text-gray-500 px-3 py-2 bg-white border-t border-blue-100">
    確定結果の進入コースと実測スタートタイミングです。目盛りはスタート予想図と同じなので、そのまま見比べられます。
    艇の長さは <strong class="font-medium">1 艇身 = {BOAT_LENGTH_SEC.toFixed(3)}秒</strong>
    （スリット付近の艇速 80km/h で艇長 3m を通過する時間）に合わせてあるので、前後の重なりがそのまま艇身差になります。
    {hasFlying && (
      <>
        {" "}
        <span class="text-red-600 font-medium">赤縁の艇と F 付きの値はフライング</span>です。
      </>
    )}
    {hasClamped && (
      <>
        {" "}
        表示レンジ（{ST_MIN.toFixed(2)}〜{ST_MAX.toFixed(2)}秒）を外れた艇は端で止めています。実測値は右の数値のとおりです。
      </>
    )}
    {hasMissingSt && <> STが取得できなかった艇（欠場・エンスト等）は水面に出していません（右の値は —）。</>}
  </figcaption>
</figure>
