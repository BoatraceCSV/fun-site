---
import type { RaceResultCourse } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  /** 確定結果の進入コース別 ST / F。並び順は問わない（内部でコース昇順にする）。 */
  courses: readonly RaceResultCourse[];
}

const { courses } = Astro.props;

// 表示レンジ・図のサイズは StartPredictionDiagram と **同一**にする。
// スタート予想と結果を同じ目盛りで見比べられることがこの図の目的なので、
// 実測値に合わせてレンジを可変にしない（レンジ外の艇は端でクランプされるが、
// 正確な値は右側の数値ラベルに必ず出る）。
const ST_MIN = -0.05; // フライング側
const ST_MAX = 0.3;
const ST_SPAN = ST_MAX - ST_MIN;

const VIEWBOX_W = 600;
const VIEWBOX_H = 360;
const LEFT_PAD = 60; // コース番号ラベル分
const RIGHT_PAD = 80; // ST値ラベル分
const TOP_PAD = 24;
const BOTTOM_PAD = 36;
const LANES = 6;
const LANE_HEIGHT = (VIEWBOX_H - TOP_PAD - BOTTOM_PAD) / LANES;
const TRACK_LEFT = LEFT_PAD;
const TRACK_RIGHT = VIEWBOX_W - RIGHT_PAD;
const TRACK_W = TRACK_RIGHT - TRACK_LEFT;

// ST → x 座標。ST=0 でスタートライン。ST が大きいほど後方（左寄り）、
// 負値（フライング）はスタートラインより前（右寄り）。
const stToX = (st: number): number => {
  const clamped = Math.min(Math.max(st, ST_MIN), ST_MAX);
  return TRACK_RIGHT - ((clamped - ST_MIN) / ST_SPAN) * TRACK_W;
};

const startLineX = stToX(0);

/** 艇の円の半径。中心をこのぶん内側に留めて水面からはみ出させない。 */
const BOAT_R = 13;
const clampBoatX = (x: number): number =>
  Math.min(Math.max(x, TRACK_LEFT + BOAT_R), TRACK_RIGHT - BOAT_R);

const tickValues = [-0.05, 0, 0.1, 0.2, 0.3];

const sortedCourses = [...courses].sort((a, b) => a.courseNumber - b.courseNumber);

/**
 * ST 未取得（欠場・エンスト等で CSV が空 → 0）の判定。
 * 結果テーブルの `c.startTiming ? … : "—"` と同じ扱いに揃えている。
 */
const hasSt = (c: RaceResultCourse): boolean => c.startTiming !== 0;

/**
 * ST ラベル。フライングは負の符号を出さず `F.03` 表記にする
 * （SessionResultsGrid / 出走表の今節成績と同じ書き方）。
 */
const stLabel = (c: RaceResultCourse): string =>
  c.flying ? `F${Math.abs(c.startTiming).toFixed(2).slice(1)}` : c.startTiming.toFixed(2);

const hasMissingSt = sortedCourses.some((c) => !hasSt(c));
const hasFlying = sortedCourses.some((c) => c.flying);
/** 表示レンジ外の艇。円は端で止まるので、数値ラベルが正なことを注記で断る。 */
const hasClamped = sortedCourses.some(
  (c) => hasSt(c) && (c.startTiming < ST_MIN || c.startTiming > ST_MAX),
);
---

<figure class="bg-blue-50 rounded-lg overflow-hidden border border-blue-100">
  <svg
    viewBox={`0 0 ${VIEWBOX_W} ${VIEWBOX_H}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="スタート結果図（進入順）"
    class="w-full h-auto"
  >
    {/* 水面背景 */}
    <rect x={TRACK_LEFT} y={TOP_PAD} width={TRACK_W} height={LANE_HEIGHT * LANES} fill="#dbeafe" />

    {/* レーン区切り */}
    {Array.from({ length: LANES + 1 }).map((_, i) => {
      const y = TOP_PAD + i * LANE_HEIGHT;
      return <line x1={TRACK_LEFT} y1={y} x2={TRACK_RIGHT} y2={y} stroke="#bfdbfe" stroke-width="1" />;
    })}

    {/* スタートライン（赤、太線） */}
    <line
      x1={startLineX}
      y1={TOP_PAD}
      x2={startLineX}
      y2={TOP_PAD + LANE_HEIGHT * LANES}
      stroke="#dc2626"
      stroke-width="2.5"
    />
    <text
      x={startLineX}
      y={TOP_PAD - 8}
      text-anchor="middle"
      font-size="11"
      fill="#dc2626"
      font-weight="600"
    >
      スタートライン
    </text>

    {/* ST 目盛り */}
    {tickValues.map((tv) => {
      const x = stToX(tv);
      return (
        <g>
          <line
            x1={x}
            y1={TOP_PAD + LANE_HEIGHT * LANES}
            x2={x}
            y2={TOP_PAD + LANE_HEIGHT * LANES + 4}
            stroke="#94a3b8"
            stroke-width="1"
          />
          <text
            x={x}
            y={TOP_PAD + LANE_HEIGHT * LANES + 16}
            text-anchor="middle"
            font-size="10"
            fill="#64748b"
          >
            {tv.toFixed(2)}
          </text>
        </g>
      );
    })}
    <text
      x={(TRACK_LEFT + TRACK_RIGHT) / 2}
      y={VIEWBOX_H - 6}
      text-anchor="middle"
      font-size="10"
      fill="#64748b"
    >
      スタートタイミング(秒)
    </text>

    {/* コース行 */}
    {sortedCourses.map((c, i) => {
      const cy = TOP_PAD + i * LANE_HEIGHT + LANE_HEIGHT / 2;
      const color = isValidBoatNumber(c.boatNumber) ? BOAT_COLORS[c.boatNumber] : undefined;
      const fill = color?.hex ?? "#cbd5e1";
      // フライングは艇を赤縁で強調する。1号艇は艇色が白なので通常時も縁を付ける。
      const stroke = c.flying ? "#dc2626" : c.boatNumber === 1 ? "#94a3b8" : fill;
      const textColor = color?.textHex ?? "#0f172a";
      // ST 未取得の艇は位置が決まらないので、レーン左端に薄く置いて数値は "—" にする。
      const boatX = hasSt(c) ? clampBoatX(stToX(c.startTiming)) : TRACK_LEFT + BOAT_R;
      return (
        <g opacity={hasSt(c) ? 1 : 0.4}>
          {/* コース番号 */}
          <text
            x={TRACK_LEFT - 14}
            y={cy + 4}
            text-anchor="end"
            font-size="13"
            fill="#1e3a8a"
            font-weight="700"
          >
            {c.courseNumber}コース
          </text>

          {/* 艇本体（円） */}
          <circle
            cx={boatX}
            cy={cy}
            r={BOAT_R}
            fill={fill}
            stroke={stroke}
            stroke-width={c.flying ? 2.5 : 1.5}
          />
          <text
            x={boatX}
            y={cy + 4}
            text-anchor="middle"
            font-size="12"
            font-weight="700"
            fill={textColor}
          >
            {c.boatNumber}
          </text>

          {/* ST 実測値 */}
          <text
            x={TRACK_RIGHT + 8}
            y={cy + 4}
            font-size="13"
            fill={c.flying ? "#dc2626" : "#0f172a"}
            font-weight={c.flying ? 700 : 400}
            font-family="monospace"
          >
            {hasSt(c) ? stLabel(c) : "—"}
          </text>
        </g>
      );
    })}
  </svg>
  <figcaption class="text-xs text-gray-500 px-3 py-2 bg-white border-t border-blue-100">
    確定結果の進入コースと実測スタートタイミングです。目盛りはスタート予想図と同じなので、そのまま見比べられます。
    {hasFlying && (
      <>
        {" "}
        <span class="text-red-600 font-medium">赤縁の艇と F 付きの値はフライング</span>です。
      </>
    )}
    {hasClamped && <> 表示レンジ（-0.05〜0.30秒）を外れた艇は端で止めています。実測値は右の数値のとおりです。</>}
    {hasMissingSt && <> STが取得できなかった艇（欠場・エンスト等）は左端に薄く表示しています。</>}
  </figcaption>
</figure>
