---
import type {
  RaceRacer,
  WeatherFeatures,
  WeatherPtBasis,
  WeatherPtBoatAggregate,
} from "@fun-site/shared";
import {
  BOAT_COLORS,
  WEATHER_PT_DAILY_NEUTRAL,
  WEATHER_PT_FEATURES,
  computeWeatherPtSteps,
  isValidBoatNumber,
  weatherPtMatchesIndex,
} from "@fun-site/shared";

interface Props {
  racer: RaceRacer;
  /** 気象pt と進入コース・順位を並べた集計 */
  aggregate: WeatherPtBoatAggregate;
  /** 寄与pt = 場別重み × 気象pt。index CSV 由来 */
  contribution: number | undefined;
  /** 強さpt（この艇の全成分の寄与合計） */
  strengthPt: number;
  /** 評価が daily（直前情報前の中立値）か */
  isDaily: boolean;
  /** 進入コースがスタート展示の実測か（false なら枠なりの仮値） */
  courseFromExhibition: boolean;
  /**
   * 気象pt の根拠（この場の気象回帰係数 + 場別 μ/σ/w）。
   * 上流の静的テーブル未取得のビルド / 古い JSON では undefined。
   */
  basis: WeatherPtBasis | undefined;
  /** このレースの水面気象から作った特徴量。sui 未取得なら undefined */
  features: WeatherFeatures | undefined;
}

const {
  racer,
  aggregate,
  contribution,
  strengthPt,
  isDaily,
  courseFromExhibition,
  basis,
  features,
} = Astro.props;

const color = isValidBoatNumber(racer.boatNumber) ? BOAT_COLORS[racer.boatNumber] : undefined;
const weatherPt = aggregate.weatherPt;

/** 係数掛け → 生値 → 偏差値 → 寄与 の再現。根拠テーブル / 水面気象が無ければ undefined */
const steps =
  basis && features ? computeWeatherPtSteps(basis, features, aggregate.courseNumber) : undefined;

/**
 * 再現値が index CSV の値と一致するか。
 *
 * 過去日を再ビルドすると、当時の index を作ったあとに係数や重みが更新されて
 * いてずれることがある。ずれたまま「= 気象pt」と書くと嘘になるので、一致した
 * ときだけ検算済みとして扱う（daily の行は計算式の外で 50 に固定されるので対象外）。
 */
const reproduced = !isDaily && weatherPtMatchesIndex(steps?.pt, weatherPt);

/** 強さptに占める気象ptの寄与割合 */
const sharePct =
  contribution !== undefined && strengthPt > 0 ? (contribution / strengthPt) * 100 : undefined;

/** 気象pt が中立値のまま（= 直前情報前 / 欠測）か */
const isNeutral = weatherPt !== undefined && weatherPt === WEATHER_PT_DAILY_NEUTRAL;

/**
 * 進入コースのずれの説明文。気象pt は**コース**に付く値なので、前付けで枠番と
 * コースがずれた艇は「枠番から想像する値」と違う値になる。
 */
const courseNote = aggregate.courseShifted
  ? `${racer.boatNumber}枠ですが進入は${aggregate.courseNumber}コースなので、気象ptも${aggregate.courseNumber}コースの値が入ります。`
  : "";

const featureLabel = new Map(WEATHER_PT_FEATURES.map((f) => [f.key, f.label]));

/** 曇り / 雨 は 0-1 のフラグなので小数を出さない。他は 1 桁（波高 cm・℃・m/s） */
const featureValue = (key: string, value: number): string =>
  key === "isCloudy" || key === "isRainy" ? String(value) : value.toFixed(1);

const num = (v: number | undefined | null, digits: number): string =>
  v === undefined || v === null ? "—" : v.toFixed(digits);

const signed = (v: number, digits: number): string => `${v >= 0 ? "+" : ""}${v.toFixed(digits)}`;

/** 式の中に埋める負数は括弧で囲む（「50 + 10 × -1.665」を避ける） */
const term = (v: number, digits: number): string =>
  v < 0 ? `(${v.toFixed(digits)})` : v.toFixed(digits);
---

<section
  class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden"
  id={`boat-${racer.boatNumber}`}
  aria-label={`${racer.boatNumber}号艇の気象pt`}
>
  {/* ヘッダ: 枠番 / 選手 / 進入コース */}
  <header class="flex items-center gap-2 px-4 py-2 border-b border-gray-100 flex-wrap">
    <span
      class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-bold shrink-0"
      style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
    >
      {racer.boatNumber}
    </span>
    <h2 class="font-bold text-base">
      <span class="text-gray-400 text-sm">{racer.boatNumber}枠</span>
      {" "}{racer.racerName}
    </h2>
    <span class="text-xs text-gray-500">
      {racer.classGrade}
      {racer.nationalWinRate > 0 && ` / 全国勝率 ${racer.nationalWinRate.toFixed(2)}`}
    </span>
    <span
      class={`ml-auto text-[11px] font-bold rounded px-1.5 py-0.5 border ${
        aggregate.courseShifted
          ? "text-amber-800 bg-amber-50 border-amber-200"
          : "text-cyan-800 bg-cyan-50 border-cyan-200"
      }`}
    >
      {aggregate.courseNumber}コース進入
    </span>
  </header>

  <div class="p-4 space-y-4">
    {/* 気象pt サマリー: 結論を先に出す */}
    <div class="rounded-md bg-cyan-50 border border-cyan-200 p-3">
      <div class="flex items-baseline gap-2 flex-wrap">
        <span class="text-xs font-bold text-cyan-800">気象pt</span>
        <span class="text-2xl font-bold font-mono tabular-nums text-cyan-900">
          {num(weatherPt, 2)}
        </span>
        {aggregate.z !== null && (
          <span class="text-[11px] text-cyan-700">
            （この場の平均より {aggregate.z >= 0 ? "+" : ""}{aggregate.z.toFixed(2)}σ）
          </span>
        )}
        {aggregate.ptRank !== null && !isDaily && (
          <span class="text-[11px] text-cyan-700">この6艇では {aggregate.ptRank}位</span>
        )}
      </div>

      {/* 有利pt変動 → 気象pt → 寄与 のフロー */}
      <ol class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-cyan-900">
        <li class="inline-flex items-baseline gap-1">
          <span class="text-cyan-700">{aggregate.courseNumber}コースの有利pt変動</span>
          <span class="font-mono font-bold tabular-nums">
            {steps === undefined ? "—" : signed(steps.rawAdvantage, 4)}
          </span>
        </li>
        <li aria-hidden="true" class="text-cyan-400">→</li>
        <li class="inline-flex items-baseline gap-1">
          <span class="text-cyan-700">気象pt</span>
          <span class="font-mono font-bold tabular-nums">{num(weatherPt, 2)}</span>
        </li>
        <li aria-hidden="true" class="text-cyan-400">→</li>
        <li class="inline-flex items-baseline gap-1">
          <span class="text-cyan-700">寄与</span>
          <span class="font-mono font-bold tabular-nums">{num(contribution, 2)}</span>
          {sharePct !== undefined && (
            <span class="text-cyan-700">
              （強さpt {strengthPt.toFixed(2)} の {sharePct.toFixed(1)}%）
            </span>
          )}
        </li>
      </ol>

      {isDaily ? (
        <p class="mt-1.5 text-[10px] text-cyan-700">
          この評価は<span class="font-bold">朝バッチ時点（直前情報前）</span>のもので、気象ptは
          中立値 {WEATHER_PT_DAILY_NEUTRAL} が入り寄与は 0 に潰されています。
          実測が入るのは水面気象が反映された評価からです。
        </p>
      ) : (
        isNeutral && (
          <p class="mt-1.5 text-[10px] text-cyan-700">
            気象ptがちょうど中立値 {WEATHER_PT_DAILY_NEUTRAL} です。この気象が
            {aggregate.courseNumber}コースの有利不利をほとんど動かしていないか、
            水面気象が欠測だった場合もこの値になります。
          </p>
        )
      )}
    </div>

    {/* 計算過程: 係数テーブルから index CSV の値まで */}
    <div>
      <h3 class="text-xs font-bold text-gray-500 mb-1.5">
        気象ptの計算過程
        {reproduced && <span class="ml-1 font-normal text-emerald-600">（表示値と一致）</span>}
        {isDaily && steps !== undefined && (
          <span class="ml-1 font-normal text-amber-600">（参考: この水面気象なら）</span>
        )}
      </h3>

      {basis === undefined || features === undefined || steps === undefined ? (
        <p class="text-[11px] text-gray-500">
          このビルドでは
          {basis === undefined
            ? "気象回帰の係数（estimate/stadium/sui_params.csv）"
            : "このレースの水面気象（previews/sui）"}
          を取得できていないため、計算過程を出せません。気象ptは BoatraceCSV が出した値を
          そのまま表示しています。
        </p>
      ) : (
        <div class="overflow-x-auto">
          {/* 1. 特徴量 × 係数 の 6 項 */}
          <table class="w-full text-[11px] border-collapse mb-2">
            <caption class="text-left text-[10px] text-gray-500 pb-1">
              1. {steps.course}コースの係数を当日の水面気象に掛ける
            </caption>
            <thead>
              <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
                <th scope="col" class="text-left py-1 px-1 font-medium">特徴量</th>
                <th scope="col" class="text-right py-1 px-1 font-medium">当日の値</th>
                <th scope="col" class="text-right py-1 px-1 font-medium">
                  係数（{steps.course}コース）
                </th>
                <th scope="col" class="text-right py-1 px-1 font-medium">寄与</th>
              </tr>
            </thead>
            <tbody class="text-gray-800">
              {steps.terms.map((t) => (
                <tr class={`border-b border-gray-100 ${t.value === 0 ? "text-gray-400" : ""}`}>
                  <th scope="row" class="text-left py-1 px-1 font-medium">
                    {featureLabel.get(t.key) ?? t.key}
                  </th>
                  <td class="py-1 px-1 text-right font-mono tabular-nums">
                    {featureValue(t.key, t.value)}
                  </td>
                  <td class="py-1 px-1 text-right font-mono tabular-nums">{signed(t.coef, 4)}</td>
                  <td
                    class={`py-1 px-1 text-right font-mono tabular-nums ${t.term !== 0 ? "font-bold" : ""}`}
                  >
                    {signed(t.term, 4)}
                  </td>
                </tr>
              ))}
              <tr>
                <th scope="row" colspan="3" class="text-right py-1 px-1 font-medium text-gray-500">
                  有利pt変動（合計）
                </th>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold">
                  {signed(steps.rawAdvantage, 4)}
                </td>
              </tr>
            </tbody>
          </table>

          {/* 2〜4. 偏差値化と重み付け */}
          <table class="w-full text-[11px] border-collapse">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
                <th scope="col" class="text-left py-1 px-1 font-medium">手順</th>
                <th scope="col" class="text-left py-1 px-1 font-medium">計算</th>
                <th scope="col" class="text-right py-1 px-1 font-medium">値</th>
              </tr>
            </thead>
            <tbody class="text-gray-800">
              <tr class="border-b border-gray-100">
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  2. 場内で標準化
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  ({term(steps.rawAdvantage, 4)} − {term(basis.mu, 4)}) ÷ {basis.sigma.toFixed(4)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold">
                  {signed(steps.z, 3)}
                </td>
              </tr>
              <tr class="border-b border-gray-100">
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  3. 偏差値に直す
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  50 + 10 × {term(steps.z, 3)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold text-cyan-800">
                  {steps.pt.toFixed(2)}
                </td>
              </tr>
              <tr>
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  4. 重みを掛ける
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  {basis.weight.toFixed(3)} × {steps.pt.toFixed(2)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold text-cyan-800">
                  {steps.contribution.toFixed(2)}
                </td>
              </tr>
            </tbody>
          </table>

          <p class="mt-1.5 text-[10px] text-gray-400">
            μ = {basis.mu.toFixed(4)} / σ = {basis.sigma.toFixed(4)} / 重み w ={" "}
            {basis.weight.toFixed(3)} はこの場の値（{basis.weightsMonth} 版の
            <span class="font-mono">weights/{basis.predictorId}</span>。直近6ヶ月から月次で学習）。
            係数は場ごとに学習された線形回帰の傾きで、コース固定の有利不利を表す切片は
            枠番ptと重複するため使いません。
            {!isDaily && !reproduced && weatherPt !== undefined && (
              <span class="text-amber-700">
                {" "}再現値 {steps.pt.toFixed(2)} が表示値 {weatherPt.toFixed(2)} と一致していません。
                この評価を作ったあとに係数または重みが更新された過去日のレースです。
              </span>
            )}
          </p>
        </div>
      )}
    </div>

    {/* コースに付く値であることの補足 */}
    <div class="text-[11px] text-gray-600 space-y-1">
      <p>
        気象ptは選手やモーターではなく<span class="font-bold">進入コース</span>に付く値です。
        当日の水面気象がこの場の{aggregate.courseNumber}コースの有利不利をどれだけ動かすかで、
        同じコースに入った艇なら誰でも同じ値になります。
        {courseNote}
        {!courseFromExhibition &&
          "このレースはスタート展示が未取得なので、進入コースは枠なりの仮値です。"}
      </p>
      {aggregate.gapToTopPt !== null && aggregate.gapToTopPt !== 0 && (
        <p>
          このレースで気象ptが最も高い艇より
          <span class="font-mono tabular-nums">{Math.abs(aggregate.gapToTopPt).toFixed(2)}</span>
          pt 低い値です。
        </p>
      )}
    </div>
  </div>
</section>
