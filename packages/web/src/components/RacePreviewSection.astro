---
import type { RacePreview } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  preview: RacePreview;
}

const { preview } = Astro.props;
const boats = [...preview.boats].sort((a, b) => a.boatNumber - b.boatNumber);
const weather = preview.weather;

/** 天候コード → ラベル（boatrace 標準: 1晴 2曇 3雨 4雪 5霧） */
const WEATHER_LABEL: Record<string, string> = {
  "1": "晴",
  "2": "曇り",
  "3": "雨",
  "4": "雪",
  "5": "霧",
};
const weatherLabel = weather ? (WEATHER_LABEL[weather.weather] ?? weather.weather) : "";

/** 気象観測時刻 HHMM → HH:MM */
const formatObservedAt = (raw: string): string => {
  const m = raw.match(/^(\d{2})(\d{2})$/);
  return m ? `${m[1]}:${m[2]}` : raw;
};

/**
 * タイム系の列で 1 番速い値と 2 番目に速い値（小さいほど速い）。
 * 同値の艇が複数いる場合は同順位として扱いたいので、**重複を潰した値**の
 * 昇順で 1 位 / 2 位を取る（1 位タイが 2 艇なら 2 位は次に小さい値になる）。
 */
type FastestTwo = { first: number | null; second: number | null };
const fastestTwo = (values: readonly (number | null | undefined)[]): FastestTwo => {
  const sorted = [...new Set(values.filter((v): v is number => v != null && v > 0))].sort(
    (a, b) => a - b,
  );
  return { first: sorted[0] ?? null, second: sorted[1] ?? null };
};

/**
 * タイム系セルの背景色。得点率早見表と同じ「セル枠いっぱいを塗る」やり方で、
 * 1 番速い艇を濃い青、2 番目を薄い青にする（速さの色は従来から青）。
 */
const speedCellClass = (v: number | null | undefined, ranks: FastestTwo): string => {
  if (v == null) return "";
  if (ranks.first != null && v === ranks.first) return "bg-blue-100 text-blue-900 font-bold";
  if (ranks.second != null && v === ranks.second) return "bg-blue-50 text-blue-800";
  return "";
};

const exhibitionRanks = fastestTwo(boats.map((b) => b.exhibitionTime));

// 表に出すのは展示タイムのみ（体重・調整・チルトは載せない）。
const hasExhibition = boats.some((b) => b.exhibitionTime != null);

// オリジナル展示（場別計測項目）。各列ごとに 1 位 / 2 位を強調する。
const orig = preview.originalExhibition;
const origBoats = orig ? [...orig.boats].sort((a, b) => a.boatNumber - b.boatNumber) : [];
const origColumnRanks: FastestTwo[] = orig
  ? orig.labels.map((_, col) => fastestTwo(origBoats.map((b) => b.values[col])))
  : [];
const hasOriginalExhibition =
  orig != null && orig.labels.length > 0 && origBoats.some((b) => b.values.some((v) => v != null));

/**
 * 展示とオリジナル展示は同じ「艇番 × 計測値」なので 1 つの表にまとめる。
 * 2 表に分けると同じ艇の行を目で往復することになるうえ、艇番列も 2 回出る。
 * 行は両者の艇番の和集合（片方にしか無い艇があっても落とさない）。
 */
const origLabels = hasOriginalExhibition && orig ? orig.labels : [];
const boatById = new Map(boats.map((b) => [b.boatNumber, b]));
const origById = new Map(origBoats.map((b) => [b.boatNumber, b]));
const boatNumbers = [
  ...new Set([...boatById.keys(), ...(hasOriginalExhibition ? origById.keys() : [])]),
].sort((a, b) => a - b);

/** 表の凡例。存在する列に応じて主語を変える（JSX で組むと空白が入るので文字列で作る） */
const previewNote = ((): string => {
  const subject =
    hasExhibition && hasOriginalExhibition
      ? "展示タイムとオリジナル展示の各項目"
      : hasExhibition
        ? "展示タイム"
        : "オリジナル展示の各項目";
  const base = `締切5分前のスナップショットです。${subject}は数値が小さいほど速く、列ごとに1番速い艇を濃い青、2番目を薄い青の背景で表示しています。`;
  return hasOriginalExhibition ? `${base}オリジナル展示の計測項目は場により異なります。` : base;
})();
---

<div>
  {weather && (
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-600 mb-3">
      {weatherLabel && (
        <span>
          <span class="text-gray-400">天候</span>
          <span class="ml-1 font-medium">{weatherLabel}</span>
        </span>
      )}
      {weather.windSpeed > 0 && (
        <span>
          <span class="text-gray-400">風速</span>
          <span class="ml-1 font-mono">{weather.windSpeed}m</span>
        </span>
      )}
      {weather.waveHeight > 0 && (
        <span>
          <span class="text-gray-400">波</span>
          <span class="ml-1 font-mono">{weather.waveHeight}cm</span>
        </span>
      )}
      {weather.airTemperature !== 0 && (
        <span>
          <span class="text-gray-400">気温</span>
          <span class="ml-1 font-mono">{weather.airTemperature}℃</span>
        </span>
      )}
      {weather.waterTemperature !== 0 && (
        <span>
          <span class="text-gray-400">水温</span>
          <span class="ml-1 font-mono">{weather.waterTemperature}℃</span>
        </span>
      )}
      {weather.observedAt && (
        <span class="text-gray-400">({formatObservedAt(weather.observedAt)} 計測)</span>
      )}
    </div>
  )}

  {/*
    展示タイム + オリジナル展示の統合表。オリジナル展示の計測項目は場により
    本数が変わるので、収まらない場によっては `overflow-x-auto` のスクロールに
    フォールバックする。
  */}
  {(hasExhibition || hasOriginalExhibition) && (
    <div class="overflow-x-auto">
      <table class="w-full text-xs border-collapse">
        <thead class="bg-gray-100 text-gray-600">
          {/*
            ヘッダは 2 段（オリジナル展示があるときのみ）。展示タイムとオリジナル展示の
            各項目はどちらも「小さいほど速いタイム」なので、色付きのタイム列が
            そのまま横に並ぶ。
          */}
          <tr class="text-[10px]">
            <th
              scope="col"
              rowspan={hasOriginalExhibition ? 2 : 1}
              class="px-1 py-1 text-left align-bottom"
            >
              艇
            </th>
            {hasExhibition && (
              <th
                scope="col"
                rowspan={hasOriginalExhibition ? 2 : 1}
                class="px-1 py-1 text-right align-bottom font-medium"
              >
                展示
              </th>
            )}
            {hasOriginalExhibition && (
              <th
                scope="colgroup"
                colspan={origLabels.length}
                class="px-1 py-1 text-center font-medium border-l border-gray-300"
              >
                オリジナル展示
              </th>
            )}
          </tr>
          {hasOriginalExhibition && (
            <tr class="text-[10px]">
              {origLabels.map((label, i) => (
                <th
                  scope="col"
                  class={`px-1 pb-1 text-right font-medium ${i === 0 ? "border-l border-gray-300" : ""}`}
                >
                  {label}
                </th>
              ))}
            </tr>
          )}
        </thead>
        <tbody>
          {boatNumbers.map((boatNumber) => {
            const color = isValidBoatNumber(boatNumber) ? BOAT_COLORS[boatNumber] : undefined;
            const b = boatById.get(boatNumber);
            const o = origById.get(boatNumber);
            return (
              <tr class="border-b border-gray-100">
                <td class="px-1 py-1">
                  <span
                    class="inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold"
                    style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                  >
                    {boatNumber}
                  </span>
                </td>
                {hasExhibition && (
                  <td
                    class={`px-1 py-1 text-right font-mono tabular-nums ${speedCellClass(b?.exhibitionTime, exhibitionRanks)}`}
                  >
                    {b?.exhibitionTime != null ? (
                      b.exhibitionTime.toFixed(2)
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>
                )}
                {origLabels.map((_, col) => {
                  const v = o?.values[col];
                  const ranks = origColumnRanks[col] ?? { first: null, second: null };
                  return (
                    <td
                      class={`px-1 py-1 text-right font-mono tabular-nums ${col === 0 ? "border-l border-gray-200" : ""} ${speedCellClass(v, ranks)}`}
                    >
                      {v != null ? v.toFixed(2) : <span class="text-gray-400">—</span>}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="text-[11px] text-gray-400 mt-2">{previewNote}</p>
    </div>
  )}
</div>
