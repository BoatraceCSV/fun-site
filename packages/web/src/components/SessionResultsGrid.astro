---
import type { SessionResultSlot } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  /** 1 選手の節間 14 スロット（時系列順、未出走含む） */
  slots: readonly SessionResultSlot[];
}

const { slots } = Astro.props;

/** 出走済みスロットのみ（未出走 = 着順空 かつ R番号 0 は除外） */
const played = slots.filter((s) => s.rank !== "" || s.race > 0);

/**
 * 日次ごとにまとめる（1 日 2 走まで）。日区切りを画面上でも見せるため、
 * バッジの羅列ではなく日ごとのグループにする。
 */
const byDay: { day: number; slots: SessionResultSlot[] }[] = [];
for (const slot of played) {
  const last = byDay[byDay.length - 1];
  if (last && last.day === slot.day) {
    last.slots.push(slot);
  } else {
    byDay.push({ day: slot.day, slots: [slot] });
  }
}

/**
 * バッジ配色は **そのレースでの枠番**（艇番カラー）、中の数字は **進入コース**。
 * 枠番不明はグレー。
 */
const laneStyle = (lane: number): string => {
  if (!isValidBoatNumber(lane)) return "background-color: #e5e7eb; color: #374151;";
  const c = BOAT_COLORS[lane];
  const border = lane === 1 ? " border: 1px solid #cbd5e1;" : "";
  return `background-color: ${c.hex}; color: ${c.textHex};${border}`;
};

/** 着順は色を付けない。特殊トークン (F/L 等) のみ文字色で区別する */
const rankTextClass = (rank: string): string => {
  if (rank === "F") return "text-red-600";
  if (rank === "L") return "text-amber-600";
  if (rank === "" || /^[1-6]$/.test(rank)) return "text-gray-800";
  return "text-gray-500";
};

/** ST 表記。負値 (F) は "F" を付け、未計測は空 */
const stText = (st: number | null): string => {
  if (st == null) return "";
  return st < 0 ? `F${Math.abs(st).toFixed(2).slice(1)}` : st.toFixed(2).slice(1);
};

/** ホバー時のツールチップ（日次・走・R・進入・枠・ST） */
const slotTitle = (s: SessionResultSlot): string => {
  const parts = [`${s.day}日目${s.run}走`];
  if (s.race > 0) parts.push(`${s.race}R`);
  if (s.entryCourse > 0) parts.push(`進入${s.entryCourse}`);
  if (s.lane > 0) parts.push(`枠${s.lane}`);
  if (s.st != null) parts.push(`ST${s.st.toFixed(2)}`);
  parts.push(`着順${s.rank || "—"}`);
  return parts.join(" / ");
};
---

{/*
  行は上から R（開催日レース）/ 進（進入コース）/ ST / 着（着順）。
  左端のラベル列と各走の列は、行ごとに同じ固定高 (h-3 / h-5 / h-3 / h-4) と
  同じ `gap-0.5` を使うことで揃えている。高さを変えるときは両方を直すこと。
*/}
{
  played.length > 0 ? (
    <div class="flex flex-wrap items-start gap-x-2 gap-y-1">
      <div class="flex flex-col gap-0.5 shrink-0 text-[9px] text-gray-400 leading-none">
        <span class="h-3 flex items-center">今節</span>
        <span class="h-3 flex items-center">R</span>
        <span class="h-5 flex items-center">進</span>
        <span class="h-3 flex items-center">ST</span>
        <span class="h-4 flex items-center">着</span>
      </div>
      {byDay.map(({ day, slots: daySlots }) => (
        <div class="flex flex-col gap-0.5 items-start">
          <span class="h-3 flex items-center text-[9px] text-gray-400 leading-none">
            {day}日目
          </span>
          <div class="flex items-start gap-1">
            {daySlots.map((s) => (
              <div class="flex flex-col gap-0.5 items-center w-8" title={slotTitle(s)}>
                <span class="h-3 flex items-center text-[9px] text-gray-400 leading-none tabular-nums">
                  {s.race > 0 ? `${s.race}R` : "—"}
                </span>
                <span
                  class="w-5 h-5 flex items-center justify-center rounded text-[11px] font-bold leading-none"
                  style={laneStyle(s.lane)}
                >
                  {s.entryCourse > 0 ? s.entryCourse : "·"}
                </span>
                <span class="h-3 flex items-center text-[9px] text-gray-400 leading-none tabular-nums">
                  {stText(s.st)}
                </span>
                <span
                  class={`h-4 flex items-center text-xs font-bold leading-none tabular-nums ${rankTextClass(s.rank)}`}
                >
                  {s.rank || "·"}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <span class="text-[10px] text-gray-400">今節成績なし</span>
  )
}
