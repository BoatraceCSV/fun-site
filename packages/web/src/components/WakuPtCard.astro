---
import type { RaceRacer, WakuPtBasis } from "@fun-site/shared";
import { BOAT_COLORS, computeWakuPtSteps, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  racer: RaceRacer;
  /** 枠番pt（偏差値）。index CSV 由来。古い JSON では undefined */
  wakuPt: number | undefined;
  /** 寄与pt = 場別重み × 枠番pt。index CSV 由来 */
  contribution: number | undefined;
  /** 強さpt（この艇の 5 成分の寄与合計） */
  strengthPt: number;
  /** 予想進入コース。stt 未取得時は枠番と同じ仮値 */
  entryCourse: number;
  /** `entryCourse` がスタート展示由来（= 仮値ではない）か */
  entryCourseFromExhibition: boolean;
  /**
   * 枠番pt の根拠（この場のコース強度テーブル + 場別 μ/σ/w）。
   * 上流の静的テーブル未取得のビルド / 古い JSON では undefined。
   */
  basis: WakuPtBasis | undefined;
}

const {
  racer,
  wakuPt,
  contribution,
  strengthPt,
  entryCourse,
  entryCourseFromExhibition,
  basis,
} = Astro.props;

const color = isValidBoatNumber(racer.boatNumber) ? BOAT_COLORS[racer.boatNumber] : undefined;

/** テーブル引き → z → 偏差値 → 寄与 の再現。根拠テーブルが無ければ undefined */
const steps = basis ? computeWakuPtSteps(basis, entryCourse) : undefined;

/**
 * 再現値が index CSV の値と一致するか。
 *
 * 過去日を再ビルドすると、当時の index を作ったあとにテーブルや重みが
 * 更新されていて 0.1pt 程度ずれることがある。ずれたまま「= 枠番pt」と
 * 書くと嘘になるので、一致したときだけ検算済みとして扱う。
 */
const reproduced =
  steps !== undefined && wakuPt !== undefined && Math.abs(steps.pt - wakuPt) < 0.05;

/** 偏差値 → z。「この場の平均から何σ上か」の言い換えに使う */
const z = wakuPt !== undefined ? (wakuPt - 50) / 10 : undefined;

/** 強さptに占める枠番ptの寄与割合 */
const sharePct =
  contribution !== undefined && strengthPt > 0 ? (contribution / strengthPt) * 100 : undefined;

/** 枠番と進入コースがずれている（= 枠番ptが引いたコースと違う）か */
const courseShifted = entryCourse > 0 && entryCourse !== racer.boatNumber;

const num = (v: number | undefined | null, digits: number): string =>
  v === undefined || v === null ? "—" : v.toFixed(digits);

const signed = (v: number, digits: number): string => `${v >= 0 ? "+" : ""}${v.toFixed(digits)}`;

/** 式の中に埋める負数は括弧で囲む（「50 + 10 × -1.665」を避ける） */
const term = (v: number, digits: number): string =>
  v < 0 ? `(${v.toFixed(digits)})` : v.toFixed(digits);
---

<section
  class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden"
  id={`boat-${racer.boatNumber}`}
  aria-label={`${racer.boatNumber}号艇の枠番pt`}
>
  {/* ヘッダ: 枠番 / 選手 / 予想進入コース */}
  <header class="flex items-center gap-2 px-4 py-2 border-b border-gray-100 flex-wrap">
    <span
      class="inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-bold shrink-0"
      style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
    >
      {racer.boatNumber}
    </span>
    <h2 class="font-bold text-base">
      <span class="text-gray-400 text-sm">{racer.boatNumber}枠</span>
      {" "}{racer.racerName}
    </h2>
    <span class="text-xs text-gray-500">
      {racer.classGrade}
      {racer.nationalWinRate > 0 && ` / 全国勝率 ${racer.nationalWinRate.toFixed(2)}`}
    </span>
    {courseShifted && (
      <span class="ml-auto text-[11px] font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded px-1.5 py-0.5">
        進入 {entryCourse}コース{entryCourseFromExhibition ? "" : "（仮）"}
      </span>
    )}
  </header>

  <div class="p-4 space-y-4">
    {/* 枠番pt サマリー: 結論を先に出す */}
    <div class="rounded-md bg-blue-50 border border-blue-200 p-3">
      <div class="flex items-baseline gap-2 flex-wrap">
        <span class="text-xs font-bold text-blue-800">枠番pt</span>
        <span class="text-2xl font-bold font-mono tabular-nums text-blue-900">
          {num(wakuPt, 2)}
        </span>
        {z !== undefined && (
          <span class="text-[11px] text-blue-700">
            （この場の平均より {z >= 0 ? "+" : ""}{z.toFixed(2)}σ）
          </span>
        )}
      </div>

      {/* テーブル引き → 枠番pt → 寄与 のフロー */}
      <ol class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-blue-900">
        <li class="inline-flex items-baseline gap-1">
          <span class="text-blue-700">コース強度</span>
          <span class="font-mono font-bold tabular-nums">{num(steps?.rawRate, 3)}</span>
        </li>
        <li aria-hidden="true" class="text-blue-400">→</li>
        <li class="inline-flex items-baseline gap-1">
          <span class="text-blue-700">枠番pt</span>
          <span class="font-mono font-bold tabular-nums">{num(wakuPt, 2)}</span>
        </li>
        <li aria-hidden="true" class="text-blue-400">→</li>
        <li class="inline-flex items-baseline gap-1">
          <span class="text-blue-700">寄与</span>
          <span class="font-mono font-bold tabular-nums">{num(contribution, 2)}</span>
          {sharePct !== undefined && (
            <span class="text-blue-700">
              （強さpt {strengthPt.toFixed(2)} の {sharePct.toFixed(1)}%）
            </span>
          )}
        </li>
      </ol>

      <p class="mt-1.5 text-[10px] text-blue-700">
        枠番ptは<span class="font-bold">この場・この季節・このコースの平均的な有利不利</span>で、
        {racer.racerName}個人の成績は入っていません{courseShifted
          ? `（この艇は ${entryCourse}コース進入${entryCourseFromExhibition ? "" : "の見込み"}なので、枠番と実際のコースがずれています）。`
          : "。"}
      </p>
    </div>

    {/* 計算過程: 根拠テーブルから index CSV の値まで */}
    <div>
      <h3 class="text-xs font-bold text-gray-500 mb-1.5">
        枠番ptの計算過程
        {reproduced && (
          <span class="ml-1 font-normal text-emerald-600">（表示値と一致）</span>
        )}
      </h3>

      {basis === undefined || steps === undefined ? (
        <p class="text-[11px] text-gray-500">
          このビルドではコース強度テーブル（<span class="font-mono">estimate/stadium/win_rate.csv</span>）を
          取得できていないため、計算過程を出せません。枠番ptは BoatraceCSV が出した値をそのまま表示しています。
        </p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-[11px] border-collapse">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
                <th scope="col" class="text-left py-1 px-1 font-medium">手順</th>
                <th scope="col" class="text-left py-1 px-1 font-medium">計算</th>
                <th scope="col" class="text-right py-1 px-1 font-medium">値</th>
              </tr>
            </thead>
            <tbody class="text-gray-800">
              <tr class="border-b border-gray-100">
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  1. テーブル引き
                </th>
                <td class="py-1 px-1 text-gray-600">
                  {basis.season}・{steps.course}コース
                  {courseShifted && (
                    <span class="text-amber-700">（枠番ではなく進入コース）</span>
                  )}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold">
                  {steps.rawRate.toFixed(3)}
                </td>
              </tr>
              <tr class="border-b border-gray-100">
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  2. 場内で標準化
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  ({steps.rawRate.toFixed(3)} − {basis.mu.toFixed(3)}) ÷ {basis.sigma.toFixed(3)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold">
                  {signed(steps.z, 3)}
                </td>
              </tr>
              <tr class="border-b border-gray-100">
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  3. 偏差値に直す
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  50 + 10 × {term(steps.z, 3)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold text-blue-800">
                  {steps.pt.toFixed(2)}
                </td>
              </tr>
              <tr>
                <th scope="row" class="text-left py-1 px-1 font-medium text-gray-500">
                  4. 重みを掛ける
                </th>
                <td class="py-1 px-1 font-mono tabular-nums text-gray-600">
                  {basis.weight.toFixed(3)} × {steps.pt.toFixed(2)}
                </td>
                <td class="py-1 px-1 text-right font-mono tabular-nums font-bold text-blue-800">
                  {steps.contribution.toFixed(2)}
                </td>
              </tr>
            </tbody>
          </table>

          <p class="mt-1.5 text-[10px] text-gray-400">
            μ = {basis.mu.toFixed(3)} / σ = {basis.sigma.toFixed(3)} / 重み w ={" "}
            {basis.weight.toFixed(3)} はこの場の値（{basis.weightsMonth} 版の
            <span class="font-mono">weights/{basis.predictorId}</span>。直近6ヶ月から月次で学習）。
            {!reproduced && wakuPt !== undefined && (
              <span class="text-amber-700">
                {" "}再現値 {steps.pt.toFixed(2)} が表示値 {wakuPt.toFixed(2)} と一致していません。
                この評価を作ったあとにテーブルまたは重みが更新された過去日のレースです。
              </span>
            )}
          </p>
        </div>
      )}
    </div>
  </div>
</section>
