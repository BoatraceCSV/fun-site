---
import type {
  PredictorSeriesAggregate,
  RacePrediction,
  SeriesBetPayoutAggregate,
} from "@fun-site/shared";
import {
  activePredictors,
  getPredictorBadge,
  getRaceGradeBadge,
  getStadiumById,
} from "@fun-site/shared";

interface Props {
  prediction: RacePrediction;
  /**
   * 当該会場の節集計 (直前買い目戦略)。3 行目の今節成績表示に使う。
   * 渡されない or null の場合は「節成績データなし」表示にフォールバック。
   * `_meta/series-summary.json` の `byStadium[stadiumId]` を呼び出し側でルックアップして渡す。
   */
  seriesAggregate?: SeriesBetPayoutAggregate | null;
}

const { prediction, seriesAggregate } = Astro.props;
const stadium = getStadiumById(prediction.stadiumId);
const stadiumName = stadium?.name ?? prediction.stadiumName;
const raceUrl = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}`;

// 確定済み判定 (詳細ページの判定と揃える)
const isConfirmed =
  prediction.raceResult !== undefined || prediction.votingDeadline === "確定";

// 2 行目に並べるサブタイトル: 節タイトル / 日次 / レース名 を空文字を除いて連結
const subtitleParts = [
  prediction.raceTitle,
  prediction.dayLabel,
  prediction.raceName,
].filter((s) => typeof s === "string" && s.length > 0);
const subtitle = subtitleParts.join(" ");

// 2 行目先頭のグレードバッジ。一般戦 (IP) や未設定の場合は null。
const gradeBadge = getRaceGradeBadge(prediction.grade ?? "");

// 3 行目: 今節成績 (直前買い目戦略) を **予想者別の回収率** で並べる。
// 表記は予想者レジストリの短縮名 ("本命予想" → "本命" / "穴予想" → "穴")。
type PredictorRecovery = {
  /** "本命" / "穴" などの短縮ラベル */
  readonly label: string;
  /** 節内に集計対象が無い予想者 (穴予想の開始前の節など) は undefined */
  readonly stats: PredictorSeriesAggregate | undefined;
};

/**
 * active な予想者を slot 昇順で回収率行に変換する。
 * 旧 JSON (`byPredictor` 未設定) ではトップフィールドが primary (slot 最小 =
 * 本命予想) の集計なので、それだけを本命に割り当て、他の予想者は欠測扱いにする。
 */
const buildRecoveries = (a: SeriesBetPayoutAggregate): PredictorRecovery[] => {
  const actives = activePredictors();
  const hasByPredictor = a.byPredictor !== undefined && Object.keys(a.byPredictor).length > 0;
  const primaryId = actives[0]?.id;
  return actives.map((p) => ({
    label: getPredictorBadge(p.id).shortName,
    stats: hasByPredictor
      ? a.byPredictor?.[p.id]
      : p.id === primaryId
        ? {
            settledRaceCount: a.settledRaceCount,
            hitCount: a.hitCount,
            totalBetCostYen: a.totalBetCostYen,
            totalPayoutYen: a.totalPayoutYen,
            hitRate: a.hitRate,
            recoveryRate: a.recoveryRate,
          }
        : undefined,
  }));
};

const recoveries = seriesAggregate ? buildRecoveries(seriesAggregate) : [];
// settledRaceCount === 0 (節初日でまだ確定 0 等) は「データなし」扱いにする。
// 予想者ごとに開始日が違うため、1 人でも集計対象があれば行を出す。
const hasSeriesData = recoveries.some((r) => (r.stats?.settledRaceCount ?? 0) > 0);
// 母数 (締切済みレース数)。予想者間でほぼ同じなので最大値を代表として出す。
const settledRaceCount = recoveries.reduce(
  (max, r) => Math.max(max, r.stats?.settledRaceCount ?? 0),
  0,
);

const formatPercent = (n: number): string => `${(n * 100).toFixed(1)}%`;
/** "2026-05-21" → "5/21" */
const shortDate = (d: string): string => {
  const parts = d.split("-");
  return `${Number(parts[1])}/${Number(parts[2])}`;
};
---

<a
  href={raceUrl}
  class="block bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100 p-4"
>
  {/* 1行目: 会場 + レース番号 / 締切 or 確定 */}
  <div class="flex items-center justify-between mb-1.5">
    <h3 class="font-bold text-base">
      {stadiumName} <span class="text-blue-600">{prediction.raceNumber}R</span>
    </h3>
    {isConfirmed ? (
      <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold leading-none bg-emerald-600 text-white">
        確定
      </span>
    ) : prediction.votingDeadline ? (
      <span class="text-xs text-gray-500">締切 {prediction.votingDeadline}</span>
    ) : null}
  </div>

  {/* 2行目: [グレード] 節タイトル 何日目 レース名 */}
  {(subtitle || gradeBadge) && (
    <p
      class="text-xs text-gray-600 mb-2 truncate flex items-center gap-1.5"
      title={`${gradeBadge ? `${gradeBadge.label} ` : ""}${subtitle}`}
    >
      {gradeBadge && (
        <span
          class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-bold leading-none shrink-0 ${gradeBadge.tailwindClass}`}
          aria-label={`グレード ${gradeBadge.label}`}
        >
          {gradeBadge.label}
        </span>
      )}
      {subtitle && <span class="truncate">{subtitle}</span>}
    </p>
  )}

  {/* 3行目: 今節成績 (直前買い目戦略の予想者別 回収率)。
       渡されない / データなしの場合は控えめなフォールバック表示。 */}
  {hasSeriesData ? (
    <div
      class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs"
      aria-label={`今節成績 ${shortDate(seriesAggregate!.seriesStartDate)} 〜 ${shortDate(seriesAggregate!.seriesEndDate)} の予想者別回収率`}
    >
      <span class="text-gray-500 shrink-0">今節</span>
      <span class="text-gray-600 shrink-0 tabular-nums">
        {shortDate(seriesAggregate!.seriesStartDate)}〜{shortDate(seriesAggregate!.seriesEndDate)}
      </span>
      <span class="text-gray-400 text-[10px] shrink-0 tabular-nums">{settledRaceCount}R</span>
      {/* 予想者別の回収率は 1 つの flex 子にまとめる。カード幅が足りないときは
          「本命 …｜穴 …」がまとまって次行に落ち、行末に区切り線だけが残らない。 */}
      <span class="flex items-center gap-2 shrink-0">
        {recoveries.map((r, i) => (
          <>
            {i > 0 && (
              <span class="text-gray-300" aria-hidden="true">|</span>
            )}
            {r.stats && r.stats.settledRaceCount > 0 ? (
              <span class={r.stats.recoveryRate >= 1 ? "text-green-700" : "text-gray-700"}>
                {r.label}{" "}
                <span class="font-bold tabular-nums">{formatPercent(r.stats.recoveryRate)}</span>
              </span>
            ) : (
              <span class="text-gray-400">{r.label} —</span>
            )}
          </>
        ))}
      </span>
    </div>
  ) : (
    <p class="text-xs text-gray-400">今節成績: 集計データなし</p>
  )}
</a>
