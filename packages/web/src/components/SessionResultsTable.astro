---
import type { RaceRacer, SessionResultSlot } from "@fun-site/shared";
import { BOAT_COLORS, isValidBoatNumber } from "@fun-site/shared";

interface Props {
  racers: readonly RaceRacer[];
}

const { racers } = Astro.props;
const sorted = [...racers].sort((a, b) => a.boatNumber - b.boatNumber);

/** 出走済みスロットのみ（未出走 = 着順空 かつ R番号 0 は除外） */
const played = (slots: readonly SessionResultSlot[]): SessionResultSlot[] =>
  slots.filter((s) => s.rank !== "" || s.race > 0);

/**
 * 列は「日次 × 走」。選手ごとに出走数が違う（前検欠場・補欠など）ので、
 * 全選手の出走済みスロットの **和集合** を列にして、同じ走が必ず同じ列に
 * 落ちるようにする（選手ごとに左詰めすると縦の比較ができない）。
 */
const columnMap = new Map<string, { key: string; day: number; run: number }>();
for (const racer of sorted) {
  for (const s of played(racer.sessionResults)) {
    const key = `${s.day}-${s.run}`;
    if (!columnMap.has(key)) columnMap.set(key, { key, day: s.day, run: s.run });
  }
}
const columns = [...columnMap.values()].sort((a, b) => a.day - b.day || a.run - b.run);

/** 日次ごとの列数（ヘッダの colspan 用） */
const dayGroups: { day: number; span: number }[] = [];
for (const col of columns) {
  const last = dayGroups[dayGroups.length - 1];
  if (last && last.day === col.day) last.span += 1;
  else dayGroups.push({ day: col.day, span: 1 });
}

/** 選手ごとに「日次-走」→ スロットの索引を作る */
const slotMapOf = (racer: RaceRacer): Map<string, SessionResultSlot> =>
  new Map(played(racer.sessionResults).map((s) => [`${s.day}-${s.run}`, s]));

/**
 * バッジ配色は **そのレースでの枠番**（艇番カラー）、中の数字は **進入コース**。
 * 枠番不明はグレー。SessionResultsTable / Waku10Section で共通の規則。
 */
const laneStyle = (lane: number): string => {
  if (!isValidBoatNumber(lane)) return "background-color: #e5e7eb; color: #374151;";
  const c = BOAT_COLORS[lane];
  const border = lane === 1 ? " border: 1px solid #cbd5e1;" : "";
  return `background-color: ${c.hex}; color: ${c.textHex};${border}`;
};

/** 着順は色を付けない。特殊トークン (F/L 等) のみ文字色で区別する */
const rankTextClass = (rank: string): string => {
  if (rank === "F") return "text-red-600";
  if (rank === "L") return "text-amber-600";
  if (rank === "" || /^[1-6]$/.test(rank)) return "text-gray-800";
  return "text-gray-500";
};

/** ST 表記。負値 (F) は "F" を付け、未計測は空 */
const stText = (st: number | null): string => {
  if (st == null) return "";
  return st < 0 ? `F${Math.abs(st).toFixed(2).slice(1)}` : st.toFixed(2).slice(1);
};

/** ホバー時のツールチップ（日次・走・R・進入・枠・ST） */
const slotTitle = (s: SessionResultSlot): string => {
  const parts = [`${s.day}日目${s.run}走`];
  if (s.race > 0) parts.push(`${s.race}R`);
  if (s.entryCourse > 0) parts.push(`進入${s.entryCourse}`);
  if (s.lane > 0) parts.push(`枠${s.lane}`);
  if (s.st != null) parts.push(`ST${s.st.toFixed(2)}`);
  parts.push(`着順${s.rank || "—"}`);
  return parts.join(" / ");
};
---

{/*
  今節成績は「1 艇 = 1 行 / 1 走 = 1 列」の <table>。艇ごとに折り返して並べると
  同じ走が縦に揃わないので、日次×走を固定列にして縦に比較できるようにしている。
  1 セルは上から R番号 / 進入コースバッジ / ST / 着順の 4 段。7 日制の 14 走までは
  横スクロールで見せ、左端の 枠 + 選手 列は sticky で残す。
*/}
<div class="space-y-3">
  <div class="overflow-x-auto">
    {/* sticky 列の影は border-collapse だと描画されないため border-separate + spacing 0 にし、
         行の区切り線は tr ではなく各セルの border-b で引く */}
    <table class="text-[11px] border-separate border-spacing-0">
      <thead>
        <tr class="text-gray-500 text-[10px]">
          <th
            scope="col"
            rowspan="2"
            class="sticky left-0 z-10 bg-white text-left py-1 px-0.5 pr-2 font-medium border-b border-gray-200 shadow-[3px_0_3px_-1px_rgba(0,0,0,0.12)]"
          >
            枠 / 選手
          </th>
          {dayGroups.map((g) => (
            <th
              scope="col"
              colspan={g.span}
              class="py-1 px-0.5 font-medium text-center border-b border-gray-100 border-l border-gray-100 whitespace-nowrap"
            >
              {g.day}日目
            </th>
          ))}
        </tr>
        <tr class="text-gray-400 text-[9px]">
          {columns.map((c, i) => (
            <th
              scope="col"
              class={`py-0.5 px-0.5 font-normal text-center border-b border-gray-200 whitespace-nowrap ${
                c.run === 1 && i > 0 ? "border-l border-gray-100" : ""
              }`}
            >
              {c.run}走
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {sorted.map((racer) => {
          const color = isValidBoatNumber(racer.boatNumber)
            ? BOAT_COLORS[racer.boatNumber]
            : undefined;
          const slots = slotMapOf(racer);
          return (
            <tr>
              <td class="sticky left-0 z-10 bg-white py-1 px-0.5 pr-2 whitespace-nowrap border-b border-gray-100 shadow-[3px_0_3px_-1px_rgba(0,0,0,0.12)]">
                <span
                  class="inline-flex items-center justify-center w-4 h-4 rounded text-[10px] font-bold align-middle"
                  style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                >
                  {racer.boatNumber}
                </span>
                <span class="ml-1 text-[11px] align-middle">{racer.racerName}</span>
              </td>
              {columns.map((c, i) => {
                const s = slots.get(c.key);
                const cellBorder = `border-b border-gray-100 ${c.run === 1 && i > 0 ? "border-l" : ""}`;
                if (!s) {
                  return (
                    <td class={`py-1 px-0.5 text-center text-[10px] text-gray-300 ${cellBorder}`}>
                      —
                    </td>
                  );
                }
                return (
                  <td class={`py-1 px-0.5 align-top ${cellBorder}`} title={slotTitle(s)}>
                    <div class="flex flex-col items-center gap-0.5 w-[20px] mx-auto">
                      <span class="h-3 flex items-center text-[8px] text-gray-400 leading-none tabular-nums">
                        {s.race > 0 ? `${s.race}R` : "—"}
                      </span>
                      <span
                        class="w-[18px] h-[18px] flex items-center justify-center rounded text-[11px] font-bold leading-none"
                        style={laneStyle(s.lane)}
                      >
                        {s.entryCourse > 0 ? s.entryCourse : "·"}
                      </span>
                      {/* フライング表記 "F.03" が 20px 幅に収まるよう ST だけ 8px */}
                      <span class="h-3 flex items-center text-[8px] text-gray-400 leading-none tabular-nums">
                        {stText(s.st)}
                      </span>
                      <span
                        class={`h-4 flex items-center text-xs font-bold leading-none tabular-nums ${rankTextClass(s.rank)}`}
                      >
                        {s.rank || "·"}
                      </span>
                    </div>
                  </td>
                );
              })}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="text-[11px] text-gray-400">
    今節の各走の成績を、走ごとに同じ列へ揃えて並べています（列は 日次 × 走、左が初日）。
    セルは上から R = レース番号、進入コースのバッジ（色はそのレースでの枠番、数字は進入コース）、
    ST = スタートタイミング（先頭の 0 を省略、F はフライング）、着順。「—」はその走に未出走。
  </p>
</div>
