---
import type {
  PredictorPrediction,
  RacePrediction,
  SeriesBetPayoutAggregate,
} from "@fun-site/shared";
import {
  getPredictorBadge,
  getRaceGradeBadge,
  getStadiumById,
  parseRaceCode,
  predictorById,
  showsAiPanelsFor,
} from "@fun-site/shared";
import PredictorCard from "../../../../components/PredictorCard.astro";
import RacePreviewSection from "../../../../components/RacePreviewSection.astro";
import UpsetMeter from "../../../../components/UpsetMeter.astro";
import RacerTable from "../../../../components/RacerTable.astro";
import RaceResultSection from "../../../../components/RaceResultSection.astro";
import SessionResultsTable from "../../../../components/SessionResultsTable.astro";
import StadiumSeriesSummary from "../../../../components/StadiumSeriesSummary.astro";
import TokutenHayamiSection from "../../../../components/TokutenHayamiSection.astro";
import Waku10Section from "../../../../components/Waku10Section.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { loadAvailableDates, loadPredictions, loadSeriesSummary } from "../../../../lib/data";

/** レース番号リンクバー用の各レースのメタ情報 */
type RaceNavItem = {
  raceNumber: number;
  raceName: string;
  votingDeadline: string;
  isConfirmed: boolean;
  /**
   * 直前買い目が的中した予想者の ID（slot 昇順）。タイルに予想者ごとの
   * アイコン（レジストリの `PredictorSpec.icon`）を並べるのに使う。
   */
  realtimeHitPredictorIds: string[];
};

export async function getStaticPaths() {
  const dates = await loadAvailableDates();
  // 節集計は当日基準で 1 ファイルにまとまっているので、全パス共通で 1 度だけ読む。
  // summary.raceDate と一致する日のパスにのみ付与する (BUILD_ALL_DATES=1 で過去日を巻き込んでも
  // 古い日付の race ページに当日サマリーが漏れないようにするため)。
  const seriesSummary = await loadSeriesSummary();
  const paths = [];

  for (const date of dates) {
    const predictions = await loadPredictions(date);
    // (date, stadiumId) ごとにレースメタ情報を集約
    const racesByStadium = new Map<string, RaceNavItem[]>();
    for (const prediction of predictions) {
      const parsed = parseRaceCode(prediction.raceCode);
      const list = racesByStadium.get(parsed.stadiumId) ?? [];
      // 確定判定: realtime 結果がセットされていれば確定。
      // ただし結果 CSV が未取得でも votingDeadline が "確定" になっているケースがあるため、
      // 文字列も併用判定する (上流 CSV の `電話投票締切予定` 列は確定後に "確定" に置き換わる)。
      const isConfirmed =
        prediction.raceResult !== undefined || prediction.votingDeadline === "確定";
      // 直前買い目が的中した予想者を全て拾う (slot 昇順)。
      // 新スキーマでは predictions[] が slot 昇順で並ぶのでそのまま filter する。
      // 旧 JSON (predictions 未設定) では legacy `betHitStatus` を primary (v1_basic) ぶんとして採用する。
      const realtimeHitPredictorIds =
        prediction.predictions !== undefined
          ? prediction.predictions.filter((p) => p.betHitStatus.realtimeHit).map((p) => p.predictorId)
          : prediction.betHitStatus?.realtimeHit
            ? ["v1_basic"]
            : [];
      list.push({
        raceNumber: prediction.raceNumber,
        raceName: prediction.raceName ?? "",
        votingDeadline: prediction.votingDeadline ?? "",
        isConfirmed,
        realtimeHitPredictorIds,
      });
      racesByStadium.set(parsed.stadiumId, list);
    }
    for (const prediction of predictions) {
      const parsed = parseRaceCode(prediction.raceCode);
      const stadiumRaces = [
        ...(racesByStadium.get(parsed.stadiumId) ?? []),
      ].sort((a, b) => a.raceNumber - b.raceNumber);
      // 節集計は summary.raceDate と当該パスの date が一致するときだけ付与。
      const seriesAggregate =
        seriesSummary && seriesSummary.raceDate === parsed.date
          ? (seriesSummary.byStadium[parsed.stadiumId] ?? null)
          : null;
      paths.push({
        params: {
          date: parsed.date,
          stadiumId: parsed.stadiumId,
          raceNumber: String(prediction.raceNumber),
        },
        props: { prediction, stadiumRaces, seriesAggregate },
      });
    }
  }

  return paths;
}

interface Props {
  prediction: RacePrediction;
  stadiumRaces: RaceNavItem[];
  seriesAggregate: SeriesBetPayoutAggregate | null;
}

const { prediction, stadiumRaces, seriesAggregate } = Astro.props;
const stadium = getStadiumById(prediction.stadiumId);
const stadiumName = stadium?.name ?? prediction.stadiumName;
const title = `${stadiumName} ${prediction.raceNumber}R - ${prediction.raceName || "スタート予想"}`;
const raceByNumber = new Map(stadiumRaces.map((r) => [r.raceNumber, r]));
// 選手pt の計算根拠ページ。AI 評価内訳の「選手」凡例から張る。active な予想者は
// 5 成分が同一で選手ptも同値なので、どのカードから飛んでも同じページでよい。
const racerPtHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/racers/`;
// モーターpt の詳細ページ。同じく AI 評価内訳の「モーター」凡例から張る。
const motorPtHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/motors/`;
// 枠番pt の詳細ページ。同じく AI 評価内訳の「枠番」から張る。
const wakuPtHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/lanes/`;
// 展示pt の詳細ページ。AI 評価内訳の「展示」(realtime 評価でのみ出る凡例) と
// 直前情報セクションの見出し右から張る。
const exhibitPtHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/exhibition/`;
// 気象pt の詳細ページ。展示pt と同じく preview 由来成分なので、AI 評価内訳の「気象」
// (realtime 評価でのみ出る凡例) と直前情報セクションの見出し右から張る。
const weatherPtHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/weather/`;
const headerGradeBadge = getRaceGradeBadge(prediction.grade ?? "");

// 今節成績表は、いずれかの選手に出走済みスロットがある場合のみ出す
// (初日は全員未出走なのでセクションごと消す)。
const hasSessionResults = prediction.racers.some((r) =>
  r.sessionResults.some((s) => s.rank !== "" || s.race > 0),
);

// 予想者ごとの予想。新スキーマで predictions[] が存在すればそれを使う。
// 旧 JSON (predictions 未設定) では aiEvaluation 単体から仮想 PredictorPrediction
// を 1 件だけ組み立て (= 本命予想相当) して同じ UI を流用する。
// レース結果の的中バッジと予想者カードの両方がこの配列を参照する。
const fromArray: readonly PredictorPrediction[] = prediction.predictions ?? [];
const predictorPredictions: readonly PredictorPrediction[] =
  fromArray.length > 0
    ? fromArray
    : [
        {
          predictorId: "v1_basic",
          predictorName: "本命予想",
          slot: 1,
          aiEvaluationDaily: prediction.aiEvaluationDaily,
          aiEvaluationRealtime: prediction.aiEvaluationRealtime,
          betPayout:
            prediction.betPayout ?? {
              daily: { betCount: 0, betCostYen: 0, payoutYen: 0, hit: false, actualSanrentan: null },
              realtime: { betCount: 0, betCostYen: 0, payoutYen: 0, hit: false, actualSanrentan: null },
            },
          betHitStatus: prediction.betHitStatus ?? { dailyHit: false, realtimeHit: false },
        },
      ];
---

<BaseLayout title={title}>
  {/* パンくず */}
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">トップ</a>
    <span class="mx-1">/</span>
    <a href={`/stadium/${prediction.stadiumId}/`} class="hover:text-blue-600">{stadiumName}</a>
    <span class="mx-1">/</span>
    <span>{prediction.raceNumber}R</span>
  </nav>

  {/* レース番号リンク (1R-12R) */}
  <nav class="bg-white rounded-lg shadow-sm p-2 mb-4 overflow-x-auto" aria-label="レース番号">
    <ul class="flex gap-1 min-w-max">
      {Array.from({ length: 12 }, (_, i) => i + 1).map((n) => {
        const isCurrent = n === prediction.raceNumber;
        const meta = raceByNumber.get(n);
        const isAvailable = meta !== undefined;
        const isConfirmed = meta?.isConfirmed ?? false;
        // 直前買い目が的中した予想者ぶんのアイコン (本命 🎯 / スジ 🧩 / 穴 💎)。
        // 割り当てはレジストリ (predictors.ts) の PredictorSpec.icon が唯一の定義元。
        const hitBadges = (meta?.realtimeHitPredictorIds ?? []).map((id) => ({
          id,
          ...getPredictorBadge(id),
        }));

        // 状態別のスタイル: 背景色そのもので識別
        // 現在     → 青ベタ (白文字)
        // 開催予定 → 青系 (薄青背景 + 青ボーダー + 青文字)
        // 確定済み → 緑系 (薄緑背景 + 緑ボーダー + 緑文字)
        // 非開催   → 灰色ベタ (淡色文字)
        // h-full: 的中アイコンが折り返して背が伸びたタイルに他のタイルも揃える
        // (active 予想者が 3 者なので「確定」+ アイコン 3 個は 1 行に収まらない)。
        const tileBase =
          "flex flex-col items-center justify-between w-[4.75rem] min-h-[4.75rem] h-full px-1 py-1.5 rounded-md select-none border-2";
        let tileClass = "";
        if (isCurrent) {
          tileClass = `${tileBase} bg-blue-600 text-white border-blue-700 shadow-sm`;
        } else if (!isAvailable) {
          tileClass = `${tileBase} bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed`;
        } else if (isConfirmed) {
          tileClass = `${tileBase} bg-emerald-50 text-emerald-900 border-emerald-300 hover:bg-emerald-100`;
        } else {
          tileClass = `${tileBase} bg-sky-50 text-sky-900 border-sky-300 hover:bg-sky-100`;
        }

        // 中身: レース番号 / レース名 / 締切 or 確定
        const inner = (
          <>
            <span class="text-sm font-bold leading-none tabular-nums">{n}R</span>
            <span class={`block text-[10px] leading-tight text-center mt-1 truncate max-w-full ${
              isCurrent
                ? "text-blue-100"
                : !isAvailable
                  ? "text-gray-400"
                  : isConfirmed
                    ? "text-emerald-700"
                    : "text-sky-700"
            }`}>
              {meta?.raceName || (isAvailable ? "—" : "未開催")}
            </span>
            {isAvailable ? (
              isConfirmed ? (
                <span class="mt-1 flex flex-wrap items-center justify-center gap-0.5">
                  <span class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-bold leading-none whitespace-nowrap ${
                    isCurrent ? "bg-white/25 text-white" : "bg-emerald-600 text-white"
                  }`}>
                    確定
                  </span>
                  {/* 直前買い目が的中した予想者のアイコンを slot 昇順に並べる。複数的中時は全て表示。 */}
                  {hitBadges.map((b) => (
                    <span
                      class="inline-block text-[12px] leading-none"
                      title={`${b.shortName}予想の直前買い目が的中`}
                      aria-label={`${b.shortName}予想の直前買い目が的中`}
                    >
                      {b.icon}
                    </span>
                  ))}
                </span>
              ) : (
                <span class={`mt-1 inline-block px-1 py-0.5 rounded text-[10px] font-mono leading-none tabular-nums ${
                  isCurrent ? "bg-white/15 text-white" : "bg-white text-sky-800 border border-sky-200"
                }`}>
                  {meta?.votingDeadline ? meta.votingDeadline : "—"}
                </span>
              )
            ) : (
              <span class="mt-1 text-[10px] leading-none">—</span>
            )}
          </>
        );

        if (isCurrent) {
          return (
            <li>
              <span class={tileClass} aria-current="page">
                {inner}
              </span>
            </li>
          );
        }
        if (isAvailable) {
          return (
            <li>
              <a
                href={`/race/${prediction.raceDate}/${prediction.stadiumId}/${n}/`}
                class={tileClass}
                aria-label={`${n}R ${meta?.raceName ?? ""}${
                  isConfirmed ? " 確定" : meta?.votingDeadline ? ` 締切 ${meta.votingDeadline}` : ""
                }${hitBadges.length > 0 ? ` (${hitBadges.map((b) => `${b.shortName}予想の直前買い目的中`).join(" / ")})` : ""}`}
              >
                {inner}
              </a>
            </li>
          );
        }
        return (
          <li>
            <span class={tileClass}>{inner}</span>
          </li>
        );
      })}
    </ul>
  </nav>

  {/* 今節成績（会場・primary predictor 直前買い目戦略の的中率 / 回収率）。
       1R-12R リンクバーの直下に置き、当該節での会場全体の傾向を最初に提示する。
       データが無い場合 (節初日で confirm 0 / summary 未生成) は何も描画しない。 */}
  <StadiumSeriesSummary agg={seriesAggregate} />

  {/* ヘッダ */}
  <header class="mb-6">
    <h1 class="text-2xl font-bold flex items-baseline gap-2 flex-wrap">
      <span>{stadiumName}</span>
      <span class="text-blue-600">{prediction.raceNumber}R</span>
      {prediction.raceName && (
        <span class="text-base text-gray-700 font-normal">{prediction.raceName}</span>
      )}
    </h1>
    <p class="text-sm text-gray-500 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
      <span>{prediction.raceDate}</span>
      {headerGradeBadge && (
        <span
          class={`inline-block px-1.5 py-0.5 rounded text-[10px] font-bold leading-none ${headerGradeBadge.tailwindClass}`}
          aria-label={`グレード ${headerGradeBadge.label}`}
        >
          {headerGradeBadge.label}
        </span>
      )}
      {prediction.raceTitle && <span>{prediction.raceTitle}</span>}
      {prediction.dayLabel && <span>{prediction.dayLabel}</span>}
      {prediction.votingDeadline && (
        <span>{prediction.votingDeadline === "確定" ? "確定" : `締切 ${prediction.votingDeadline}`}</span>
      )}
    </p>
  </header>

  {/* レース結果（確定済みのみ表示） */}
  {prediction.raceResult && (
    <section class="bg-white rounded-lg shadow-sm p-4 mb-6 border-l-4 border-blue-500">
      <h2 class="font-bold text-lg mb-3">レース結果</h2>
      <RaceResultSection result={prediction.raceResult} predictions={predictorPredictions} />
    </section>
  )}

  {/* 出走表（基本情報） */}
  {prediction.racers.length > 0 && (
    <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
      <h2 class="font-bold text-lg mb-3">出走表</h2>
      <RacerTable racers={prediction.racers} stadiumId={prediction.stadiumId} />
    </section>
  )}

  {/* 直前情報（締切5分前の展示・気象スナップショット）。
       previews/tkz / previews/sui が未取得のレースでは prediction.preview が無いので非表示。 */}
  {prediction.preview &&
    (prediction.preview.boats.length > 0 ||
      prediction.preview.weather ||
      prediction.preview.originalExhibition) && (
      <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
        {/* 展示pt / 気象pt の詳細ページは同じ直前情報をそれぞれの pt と並べて出すので、
             ここからも張る (daily 評価では AI 評価バーに展示・気象セグメントが出ず、
             凡例からの導線が無い) */}
        <div class="flex items-baseline justify-between gap-2 mb-3 flex-wrap">
          <h2 class="font-bold text-lg">直前情報</h2>
          <span class="flex items-baseline gap-3 shrink-0">
            <a href={exhibitPtHref} class="text-xs text-blue-700 hover:underline">
              展示ptの詳細 <span aria-hidden="true">▸</span>
            </a>
            <a href={weatherPtHref} class="text-xs text-blue-700 hover:underline">
              気象ptの詳細 <span aria-hidden="true">▸</span>
            </a>
          </span>
        </div>
        <RacePreviewSection preview={prediction.preview} />
      </section>
    )}

  {/* 枠番別過去10走。programs/waku10 が未取得のレースでは非表示。 */}
  {prediction.waku10 && prediction.waku10.boats.length > 0 && (
    <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
      {/* 枠番pt の詳細ページは同じ waku10 を枠番ptと並べて出すので、ここからも張る */}
      <div class="flex items-baseline justify-between gap-2 mb-3">
        <h2 class="font-bold text-lg">枠番別過去10走</h2>
        <a href={wakuPtHref} class="text-xs text-blue-700 hover:underline shrink-0">
          枠番ptの詳細 <span aria-hidden="true">▸</span>
        </a>
      </div>
      <Waku10Section waku10={prediction.waku10} />
    </section>
  )}

  {/* 今節成績。初日など全員未出走のレースでは非表示。 */}
  {prediction.racers.length > 0 && hasSessionResults && (
    <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
      <h2 class="font-bold text-lg mb-3">今節成績</h2>
      <SessionResultsTable racers={prediction.racers} />
    </section>
  )}

  {/* 荒れ度メーター (レース単位。予想者に紐づかないので予想者カードの外に 1 回だけ) */}
  {prediction.upsetMeter && (
    <section class="mb-6 rounded-lg border border-gray-200 bg-white p-4">
      <UpsetMeter meter={prediction.upsetMeter} />
    </section>
  )}

  {/* 予想者ごとの買い目・回収率・AI 評価 */}
  {predictorPredictions.map((pp) => {
    // 描画分岐はレジストリ (predictors.ts) の PredictorSpec 駆動にする。
    // slot / ID のハードコード列挙を増やさず、新規予想者を追加しても自動で
    // 正しく描画されるようにするため (v6_course / v7_aggregate もこれで表示される)。
    const spec = predictorById(pp.predictorId);
    // 1マーク距離 (= 買い目 = 回収率) の予測 ST を AI 推定 ST にするかは
    // 予想者ごとの useEstimatedST で決める。ここは A/B の対象なので触らない。
    const usesEstimatedST = spec?.useEstimatedST === true;
    // スタート予想図は **予想者に依らず** AI 推定 ST 版 (startPredictionEstimated)
    // を使う。racer_st が無い日は共通図 (全国平均 ST) にフォールバック。
    //
    // 予想者ごとに出し分けない理由: 図は表示専用で買い目にも回収率にも効かない一方、
    // 予測 ST を 1 点で描くとスリットの先頭コースを 7 割外す。AI 推定 ST 版だけが
    // 予測区間 (帯) を持ち、その不確実性を図に出せる。useEstimatedST な予想者が
    // 全て退役しても帯を出し続けるため、フラグから切り離してある。
    // 経緯は BoatraceCSV docs/design/slit_sim_plan.md §9。
    const startPrediction = prediction.startPredictionEstimated ?? prediction.startPrediction;
    // 1マーク予想は予想者ごとの AI 評価 (realtime 優先) で図が異なる。primary
    // (slot=1) は後方互換のため平坦化した prediction.aiEvaluation を使う。
    const oneMarkAiEvaluation =
      pp.slot === 1
        ? prediction.aiEvaluation
        : (pp.aiEvaluationRealtime ?? pp.aiEvaluationDaily);
    // AI 評価の内訳 / スタート予想 / 1マーク予想 の 3 パネルを出すか。
    // 買い目がこれらと無関係な予想者 (穴予想 v10_kimarite) では出さない。
    const showsAiPanels = showsAiPanelsFor(pp.predictorId);
    // recipeNote: 本命予想 (control) からの差分説明。予想者ごとに固有文言。
    const recipeNote =
      pp.predictorId === "v4_motor"
        ? "本命予想の5成分のうち、モーターpt をエキスパート評価でチューニングしたモーター能力指数に置き換えた構成です。"
        : pp.predictorId === "v5_slit"
          ? "本命予想と同じ5成分ですが、買い目の選定基準になる1マーク予想の予測STを、全国平均STから実測ST履歴ベースのAI推定STに置き換えた構成です。"
          : pp.predictorId === "v6_course"
            ? "本命予想の5成分のうち、枠番pt を場×レース番号×コース別のコース強度pt（コースpt）に置き換えた構成です。"
            : pp.predictorId === "v7_aggregate"
              ? "本命予想をベースに、モーターpt をチューニング版モーター能力指数に、枠番pt をコース強度pt（コースpt）に置き換え、さらに1マーク予想の予測STをAI推定STにした、モーター予想・コース予想・スリット予想の3仮説を統合した構成です。"
              : pp.predictorId === "v8_aionly"
                ? "統合予想と同じ5成分（AI評価は同値）ですが、買い目を1マーク予想の走行距離（予測ST込み）ではなく、AI総合評価の強さポイントのみ（±5.0pt）で選定する構成です。"
                : pp.predictorId === "v2_tenkai"
                  ? "本命予想の5成分のうち、モーターpt を公式モーター2連対率pt（M2連率）に置き換えた構成です。"
                  : pp.predictorId === "v3_tenkai"
                    ? "本命予想の5成分に展開優位pt（進入コースと枠番デフォルトコースの勝率差）を加えた6成分の構成です。"
                    : undefined;
    return (
      <section class="mb-6">
        <PredictorCard
          prediction={pp}
          racers={prediction.racers}
          showChart={showsAiPanels}
          startPrediction={showsAiPanels ? startPrediction : undefined}
          oneMarkAiEvaluation={showsAiPanels ? oneMarkAiEvaluation : undefined}
          useOneMarkEstimatedST={usesEstimatedST}
          recipeNote={recipeNote}
          racerPtHref={racerPtHref}
          motorPtHref={motorPtHref}
          wakuPtHref={wakuPtHref}
          exhibitPtHref={exhibitPtHref}
          weatherPtHref={weatherPtHref}
        />
      </section>
    );
  })}

  {/* 得点率早見。previews/tokuten_hayami に行が無い（予選最終日を過ぎた /
       その節は得点率早見を出さない / 未公開）レースでは非表示。 */}
  {prediction.tokutenHayami && prediction.tokutenHayami.racers.length > 0 && (
    <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
      <h2 class="font-bold text-lg mb-3">得点率早見</h2>
      <TokutenHayamiSection tokutenHayami={prediction.tokutenHayami} />
    </section>
  )}

  <div class="text-center mt-6">
    <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">← トップページに戻る</a>
  </div>
</BaseLayout>
