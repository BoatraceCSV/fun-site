---
import type { RacePrediction, RaceRacer, RacerPtBreakdown } from "@fun-site/shared";
import {
  BOAT_COLORS,
  COMPONENT_MISSING_FALLBACK,
  RACER_PT_GRADE_BUCKET_LABELS,
  RACER_PT_SCORE_TABLE,
  computeRacerPtBreakdown,
  getStadiumById,
  isValidBoatNumber,
  parseRaceCode,
  racerPtSessionInputs,
} from "@fun-site/shared";
import RacerPtCard from "../../../../../components/RacerPtCard.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { loadAvailableDates, loadPredictions } from "../../../../../lib/data";

export async function getStaticPaths() {
  const dates = await loadAvailableDates();
  const paths = [];
  for (const date of dates) {
    for (const prediction of await loadPredictions(date)) {
      const parsed = parseRaceCode(prediction.raceCode);
      paths.push({
        params: {
          date: parsed.date,
          stadiumId: parsed.stadiumId,
          raceNumber: String(prediction.raceNumber),
        },
        props: { prediction },
      });
    }
  }
  return paths;
}

interface Props {
  prediction: RacePrediction;
}

const { prediction } = Astro.props;
const stadium = getStadiumById(prediction.stadiumId);
const stadiumName = stadium?.name ?? prediction.stadiumName;
const raceHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/`;
const title = `${stadiumName} ${prediction.raceNumber}R 選手詳細 - 選手ptの内訳`;

/*
  選手pt は index CSV の成分の 1 つ。preview 由来ではないので daily 行と realtime 行で
  値は変わらないが、強さpt（寄与の分母）は realtime で更新されるため、評価の状態を
  明示したうえで realtime を優先して使う。`aiEvaluation` は primary predictor の
  realtime ?? daily を平坦化したもの。
*/
const evaluation = prediction.aiEvaluation;
const entryByBoat = new Map(evaluation.entries.map((e) => [e.boatNumber, e]));
const recentFormByBoat = new Map((prediction.recentForm?.boats ?? []).map((b) => [b.boatNumber, b]));
const hasRecentForm = prediction.recentForm !== undefined;

type RacerPtView = {
  readonly racer: RaceRacer;
  readonly breakdown: RacerPtBreakdown;
  readonly racerPt: number | undefined;
  readonly contribution: number | undefined;
  readonly strengthPt: number;
};

const views: RacerPtView[] = [...prediction.racers]
  .sort((a, b) => a.boatNumber - b.boatNumber)
  .map((racer) => {
    const form = recentFormByBoat.get(racer.boatNumber);
    const breakdown = computeRacerPtBreakdown(
      form ? racerPtSessionInputs(form) : [],
    );
    const entry = entryByBoat.get(racer.boatNumber);
    return {
      racer,
      breakdown,
      racerPt: entry?.components?.racer,
      contribution: entry?.contribution.racer,
      strengthPt: entry?.strengthPt ?? 0,
    };
  });

/** 選手pt の場内順位（1 が最上位）。未取得の艇は順位を付けない */
const ptRank = new Map<number, number>();
[...views]
  .filter((v) => v.racerPt !== undefined)
  .sort((a, b) => (b.racerPt ?? 0) - (a.racerPt ?? 0))
  .forEach((v, i) => ptRank.set(v.racer.boatNumber, i + 1));

const maxPt = Math.max(1, ...views.map((v) => v.racerPt ?? 0));
const fallbackPt = COMPONENT_MISSING_FALLBACK.racer ?? 50;

const num = (v: number | undefined, digits: number): string =>
  v === undefined ? "—" : v.toFixed(digits);
---

<BaseLayout title={title}>
  {/* パンくず */}
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">トップ</a>
    <span class="mx-1">/</span>
    <a href={`/stadium/${prediction.stadiumId}/`} class="hover:text-blue-600">{stadiumName}</a>
    <span class="mx-1">/</span>
    <a href={raceHref} class="hover:text-blue-600">{prediction.raceNumber}R</a>
    <span class="mx-1">/</span>
    <span>選手詳細</span>
  </nav>

  {/* ヘッダ */}
  <header class="mb-6">
    <h1 class="text-2xl font-bold flex items-baseline gap-2 flex-wrap">
      <span>{stadiumName}</span>
      <span class="text-blue-600">{prediction.raceNumber}R</span>
      <span class="text-base text-gray-700 font-normal">選手詳細</span>
    </h1>
    <p class="text-sm text-gray-500 mt-1">
      {prediction.raceDate}
      {prediction.raceName && ` / ${prediction.raceName}`}
      {" / AI総合評価の"}
      <span class="font-bold text-emerald-700">選手pt</span>
      がどのデータからどう計算されているかを開示するページです。
    </p>
  </header>

  {/* 6艇まとめ */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <h2 class="font-bold text-lg mb-3">選手pt 一覧</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-[11px] border-collapse">
        <thead>
          <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
            <th scope="col" class="text-left py-1 px-1 font-medium">枠</th>
            <th scope="col" class="text-left py-1 px-1 font-medium">選手</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">素点</th>
            <th scope="col" class="text-left py-1 px-1 font-medium w-1/3">選手pt</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">寄与</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">強さpt</th>
          </tr>
        </thead>
        <tbody>
          {views.map((v) => {
            const color = isValidBoatNumber(v.racer.boatNumber)
              ? BOAT_COLORS[v.racer.boatNumber]
              : undefined;
            const rank = ptRank.get(v.racer.boatNumber);
            const widthPct = v.racerPt !== undefined ? (v.racerPt / maxPt) * 100 : 0;
            const isFallback = hasRecentForm && v.breakdown.basePoint === null;
            return (
              <tr class="border-b border-gray-100">
                <td class="py-1 px-1 align-middle">
                  <span
                    class="inline-flex items-center justify-center w-4 h-4 rounded text-[10px] font-bold"
                    style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${v.racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                  >
                    {v.racer.boatNumber}
                  </span>
                </td>
                <td class="py-1 px-1 align-middle">
                  <a
                    href={`#boat-${v.racer.boatNumber}`}
                    class="text-[12px] font-medium text-blue-700 hover:underline"
                  >
                    {v.racer.racerName}
                  </a>
                </td>
                <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-800">
                  {isFallback ? (
                    <span class="text-amber-700" title="近5節の出走履歴なし">補完</span>
                  ) : (
                    (v.breakdown.basePoint ?? "—")
                  )}
                </td>
                <td class="py-1 px-1 align-middle">
                  <span class="flex items-center gap-1.5">
                    <span class="flex-1 h-3 bg-gray-100 rounded overflow-hidden min-w-8">
                      <span
                        class="block h-full bg-emerald-500"
                        style={`width: ${widthPct}%`}
                        aria-hidden="true"
                      />
                    </span>
                    <span class="font-mono tabular-nums text-gray-800 w-10 text-right">
                      {num(v.racerPt, 1)}
                    </span>
                    {rank !== undefined && (
                      <span
                        class={`w-6 text-[10px] text-right ${rank === 1 ? "font-bold text-emerald-700" : "text-gray-400"}`}
                      >
                        {rank}位
                      </span>
                    )}
                  </span>
                </td>
                <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-800">
                  {num(v.contribution, 2)}
                </td>
                <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-500">
                  {v.strengthPt.toFixed(2)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="text-[11px] text-gray-400 mt-2">
      選手ptは偏差値スケール（この場の平均が50、標準偏差が10）。寄与 = 場別重み × 選手pt で、
      強さptはこの寄与を含む5成分の合計です。評価は
      <span class="font-mono">{evaluation.state === "realtime" ? "直前情報反映後" : "朝バッチ時点"}</span>
      のもの（選手pt自体は直前情報では変わりません）。
    </p>
  </section>

  {/* 選手ごとの内訳 */}
  <div class="space-y-4 mb-6">
    {views.map((v) => (
      <RacerPtCard
        racer={v.racer}
        breakdown={v.breakdown}
        racerPt={v.racerPt}
        contribution={v.contribution}
        strengthPt={v.strengthPt}
        hasRecentForm={hasRecentForm}
      />
    ))}
  </div>

  {/* 計算ロジックの解説 */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <details>
      <summary class="font-bold text-lg cursor-pointer">選手ptの計算ロジック</summary>

      <div class="mt-3 space-y-4 text-sm text-gray-700">
        <div>
          <h3 class="font-bold text-sm mb-1">3段階で決まる</h3>
          <ol class="list-decimal list-inside space-y-1 text-[13px]">
            <li>
              <span class="font-bold">素点（算出基準点）</span> = 着順スコアの合計 ÷ 出走回数。
              入力は全国直近5節と当地直近5節の着順列。式は br-racers.jp の能力指数算出式に準拠
            </li>
            <li>
              <span class="font-bold">選手pt</span> = 50 + 10 × (素点 − μ) ÷ σ。
              μ・σ は開催場ごとに直近6ヶ月のデータから月次で学習した平均・標準偏差
            </li>
            <li>
              <span class="font-bold">寄与</span> = 場別重み w × 選手pt。
              5成分の寄与を合計したものが強さptになります（重みの合計は 1）
            </li>
          </ol>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">着順スコア表</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-[11px] border-collapse">
              <thead>
                <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
                  <th scope="col" class="text-left py-1 px-1 font-medium">グレード</th>
                  <th scope="col" class="text-left py-1 px-1 font-medium">区分</th>
                  {[1, 2, 3, 4, 5, 6].map((n) => (
                    <th scope="col" class="text-right py-1 px-1 font-medium">{n}着</th>
                  ))}
                </tr>
              </thead>
              <tbody class="font-mono tabular-nums text-gray-800">
                {(Object.keys(RACER_PT_SCORE_TABLE) as (keyof typeof RACER_PT_SCORE_TABLE)[]).flatMap(
                  (bucket) =>
                    (["yusho", "other"] as const).map((kind) => (
                      <tr class="border-b border-gray-100">
                        <th
                          scope="row"
                          class="text-left py-1 px-1 font-sans font-medium text-gray-600 whitespace-nowrap"
                        >
                          {kind === "yusho" ? RACER_PT_GRADE_BUCKET_LABELS[bucket] : ""}
                        </th>
                        <td class="py-1 px-1 font-sans text-gray-500 whitespace-nowrap">
                          {kind === "yusho" ? "優勝戦" : "通常"}
                        </td>
                        {RACER_PT_SCORE_TABLE[bucket][kind].map((score) => (
                          <td class="text-right py-1 px-1">{score}</td>
                        ))}
                      </tr>
                    )),
                )}
              </tbody>
            </table>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">
            一般戦はGⅢと同じ区分で計算されます。着順列の <span class="font-mono">[N]</span>
            表記が優勝戦です。
          </p>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">着順以外のトークンの扱い</h3>
          <ul class="space-y-1 text-[13px]">
            <li>
              <span class="font-bold text-red-600">F・L・失・妨</span>（選手責任）—
              得点は0だが<span class="font-bold">出走回数には数える</span>ため、素点を強く下げます
            </li>
            <li>
              <span class="font-bold text-gray-400">欠・転・落・沈・エ・不</span>（選手責任外）—
              得点・出走回数とも<span class="font-bold">計上しません</span>（無かった扱い）
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">補足</h3>
          <ul class="space-y-1 text-[13px]">
            <li>
              全国5節と当地5節は重複を除かずに連結されるため、当地で走った節は
              <span class="font-bold">2回計上</span>されます
            </li>
            <li>
              素点が計算できない場合（近5節に有効な出走履歴が無い）、選手ptは平均の50ではなく
              <span class="font-mono font-bold">{fallbackPt}</span> で補完されます
            </li>
            <li>
              選手ptは展示・気象と違い朝バッチの時点で確定し、直前情報では更新されません
            </li>
          </ul>
        </div>

        <p class="text-[11px] text-gray-500">
          データと計算式の一次情報は
          <a
            href="https://github.com/BoatraceCSV/boatracecsv.github.io/blob/main/docs/data/estimate.md"
            class="text-blue-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer">BoatraceCSV の Strength Index ドキュメント</a
          >を参照してください。
        </p>
      </div>
    </details>
  </section>

  <div class="text-center mt-6">
    <a href={raceHref} class="text-blue-600 hover:text-blue-800 text-sm">
      ← {stadiumName} {prediction.raceNumber}R に戻る
    </a>
  </div>
</BaseLayout>
