---
import type { RaceRacer, RacePrediction, WakuSeason } from "@fun-site/shared";
import {
  BOAT_COLORS,
  WAKU_PT_TABLE_AXES,
  WAKU_SEASONS,
  computeWakuPtSteps,
  getStadiumById,
  isValidBoatNumber,
  parseRaceCode,
} from "@fun-site/shared";
import WakuPtCard from "../../../../../components/WakuPtCard.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { loadAvailableDates, loadPredictions } from "../../../../../lib/data";

export async function getStaticPaths() {
  const dates = await loadAvailableDates();
  const paths = [];
  for (const date of dates) {
    for (const prediction of await loadPredictions(date)) {
      const parsed = parseRaceCode(prediction.raceCode);
      paths.push({
        params: {
          date: parsed.date,
          stadiumId: parsed.stadiumId,
          raceNumber: String(prediction.raceNumber),
        },
        props: { prediction },
      });
    }
  }
  return paths;
}

interface Props {
  prediction: RacePrediction;
}

const { prediction } = Astro.props;
const stadium = getStadiumById(prediction.stadiumId);
const stadiumName = stadium?.name ?? prediction.stadiumName;
const raceHref = `/race/${prediction.raceDate}/${prediction.stadiumId}/${prediction.raceNumber}/`;
const title = `${stadiumName} ${prediction.raceNumber}R 枠番詳細 - 枠番ptの読み方`;

/*
  枠番pt は index CSV の成分の 1 つ。preview 由来ではないので daily 行と realtime 行で
  値は変わらないが、強さpt（寄与の分母）は realtime で更新されるため、評価の状態を
  明示したうえで realtime を優先して使う。`aiEvaluation` は primary predictor の
  realtime ?? daily を平坦化したもの。
*/
const evaluation = prediction.aiEvaluation;
const entryByBoat = new Map(evaluation.entries.map((e) => [e.boatNumber, e]));

/**
 * 枠番pt の根拠（この場のコース強度テーブルと場別 μ/σ/w）。
 * 上流の静的テーブルを取り込む前にビルドされた JSON では undefined。
 */
const basis = prediction.wakuPtBasis;

/** 予想進入コース。stt 未取得のレースでは枠番と同じ仮値が入っている */
const courseByBoat = new Map(
  prediction.startPrediction.entries.map((e) => [e.boatNumber, e.courseNumber]),
);
const courseFromExhibition = prediction.startPrediction.fromExhibition;

type WakuPtView = {
  readonly racer: RaceRacer;
  readonly wakuPt: number | undefined;
  readonly contribution: number | undefined;
  readonly strengthPt: number;
  readonly entryCourse: number;
  /** テーブルから引いた生値（コース強度）。根拠未取得なら undefined */
  readonly rawRate: number | undefined;
};

const views: WakuPtView[] = [...prediction.racers]
  .sort((a, b) => a.boatNumber - b.boatNumber)
  .map((racer) => {
    const entry = entryByBoat.get(racer.boatNumber);
    const entryCourse = courseByBoat.get(racer.boatNumber) ?? racer.boatNumber;
    return {
      racer,
      wakuPt: entry?.components?.waku,
      contribution: entry?.contribution.waku,
      strengthPt: entry?.strengthPt ?? 0,
      entryCourse,
      rawRate: basis ? computeWakuPtSteps(basis, entryCourse)?.rawRate : undefined,
    };
  });

/** 枠番pt の場内順位（1 が最上位）。未取得の艇は順位を付けない */
const ptRank = new Map<number, number>();
[...views]
  .filter((v) => v.wakuPt !== undefined)
  .sort((a, b) => (b.wakuPt ?? 0) - (a.wakuPt ?? 0))
  .forEach((v, i) => ptRank.set(v.racer.boatNumber, i + 1));

const maxPt = Math.max(1, ...views.map((v) => v.wakuPt ?? 0));

/** 枠なり進入でない艇が 1 艇でもあるか（前付けがあると枠番とコースがずれる） */
const hasCourseShift = views.some((v) => v.entryCourse !== v.racer.boatNumber);

/** コース番号 → そのコースに入る艇（テーブルのセルに艇番バッジを出すため） */
const boatsByCourse = new Map<number, number[]>();
for (const v of views) {
  boatsByCourse.set(v.entryCourse, [...(boatsByCourse.get(v.entryCourse) ?? []), v.racer.boatNumber]);
}

/** テーブル内の最大・最小（セルの濃淡に使う） */
const allRates = basis
  ? WAKU_SEASONS.flatMap((s: WakuSeason) => [...basis.ratesBySeason[s]])
  : [];
const rateMin = allRates.length > 0 ? Math.min(...allRates) : 0;
const rateMax = allRates.length > 0 ? Math.max(...allRates) : 1;

/** 勝率の高さを 0〜1 に正規化（セル背景の濃さ） */
const rateShade = (v: number): number =>
  rateMax > rateMin ? (v - rateMin) / (rateMax - rateMin) : 0;

const num = (v: number | undefined | null, digits: number): string =>
  v === undefined || v === null ? "—" : v.toFixed(digits);
---

<BaseLayout title={title}>
  {/* パンくず */}
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">トップ</a>
    <span class="mx-1">/</span>
    <a href={`/stadium/${prediction.stadiumId}/`} class="hover:text-blue-600">{stadiumName}</a>
    <span class="mx-1">/</span>
    <a href={raceHref} class="hover:text-blue-600">{prediction.raceNumber}R</a>
    <span class="mx-1">/</span>
    <span>枠番詳細</span>
  </nav>

  {/* ヘッダ */}
  <header class="mb-6">
    <h1 class="text-2xl font-bold flex items-baseline gap-2 flex-wrap">
      <span>{stadiumName}</span>
      <span class="text-blue-600">{prediction.raceNumber}R</span>
      <span class="text-base text-gray-700 font-normal">枠番詳細</span>
    </h1>
    <p class="text-sm text-gray-500 mt-1">
      {prediction.raceDate}
      {prediction.raceName && ` / ${prediction.raceName}`}
      {" / AI総合評価の"}
      <span class="font-bold text-blue-700">枠番pt</span>
      が何を測っている数字なのかを開示するページです。
    </p>
  </header>

  {/* 根拠テーブル: 場 × 季節 × コース */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <h2 class="font-bold text-lg mb-1">{stadiumName}のコース強度テーブル</h2>
    <p class="text-[11px] text-gray-500 mb-3">
      枠番ptの<span class="font-bold">唯一の入力</span>。
      {WAKU_PT_TABLE_AXES.join(" × ")}別の長期勝率で、選手・モーター・その日の条件は一切入りません。
    </p>

    {basis === undefined ? (
      <p class="text-[11px] text-gray-500">
        このビルドではコース強度テーブル（<span class="font-mono">estimate/stadium/win_rate.csv</span>）を
        取得できていません。枠番ptは BoatraceCSV が出した値をそのまま表示しています。
      </p>
    ) : (
      <>
        <div class="overflow-x-auto">
          <table class="w-full text-[11px] border-collapse">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
                <th scope="col" class="text-left py-1 px-1 font-medium">季節</th>
                {[1, 2, 3, 4, 5, 6].map((c) => (
                  <th scope="col" class="text-right py-1 px-1 font-medium">{c}コース</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {WAKU_SEASONS.map((season: WakuSeason) => {
                const current = season === basis.season;
                return (
                  <tr class={`border-b border-gray-100 ${current ? "bg-blue-50" : ""}`}>
                    <th
                      scope="row"
                      class={`text-left py-1 px-1 font-medium ${current ? "text-blue-800" : "text-gray-500"}`}
                    >
                      {season}
                      {current && (
                        <span class="ml-1 text-[9px] font-normal text-blue-600">← 今回</span>
                      )}
                    </th>
                    {basis.ratesBySeason[season].map((rate, i) => {
                      const boats = current ? (boatsByCourse.get(i + 1) ?? []) : [];
                      return (
                        <td
                          class="py-1 px-1 text-right font-mono tabular-nums text-gray-800"
                          style={`background-color: rgba(37, 99, 235, ${(rateShade(rate) * 0.18).toFixed(3)});`}
                        >
                          <span class={current ? "font-bold" : ""}>{rate.toFixed(3)}</span>
                          {boats.length > 0 && (
                            <span class="flex justify-end gap-0.5 mt-0.5">
                              {boats.map((b) => {
                                const c = isValidBoatNumber(b) ? BOAT_COLORS[b] : undefined;
                                return (
                                  <span
                                    class="inline-flex items-center justify-center w-3.5 h-3.5 rounded text-[9px] font-bold"
                                    style={`background-color: ${c?.hex ?? "#999"}; color: ${c?.textHex ?? "#fff"};${b === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                                    title={`${b}号艇が${i + 1}コース`}
                                  >
                                    {b}
                                  </span>
                                );
                              })}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <p class="text-[11px] text-gray-400 mt-2">
          値は<span class="font-bold">勝率（平均得点）</span>です。1着10点〜6着1点の平均で、
          全コース平均は 5 前後。1着率(%) ではありません。
          艇番バッジは今回の各艇が入るコース（
          {courseFromExhibition ? "スタート展示の実測進入" : "枠なり進入の仮置き"}）。
          このテーブルはその場の過去数年ぶんの着順実績から作られた据え置きの値で、
          同じ場・同じ季節なら全レース共通です。
        </p>
      </>
    )}
  </section>

  {/* 6艇まとめ */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <h2 class="font-bold text-lg mb-3">枠番pt 一覧</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-[11px] border-collapse">
        <thead>
          <tr class="border-b border-gray-200 text-gray-500 text-[10px]">
            <th scope="col" class="text-left py-1 px-1 font-medium">枠</th>
            <th scope="col" class="text-left py-1 px-1 font-medium">選手</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">進入</th>
            {basis !== undefined && (
              <th scope="col" class="text-right py-1 px-1 font-medium">テーブル値</th>
            )}
            <th scope="col" class="text-left py-1 px-1 font-medium w-1/3">枠番pt</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">寄与</th>
            <th scope="col" class="text-right py-1 px-1 font-medium">強さpt</th>
          </tr>
        </thead>
        <tbody>
          {views.map((v) => {
            const color = isValidBoatNumber(v.racer.boatNumber)
              ? BOAT_COLORS[v.racer.boatNumber]
              : undefined;
            const rank = ptRank.get(v.racer.boatNumber);
            const widthPct = v.wakuPt !== undefined ? (v.wakuPt / maxPt) * 100 : 0;
            const shifted = v.entryCourse !== v.racer.boatNumber;
            return (
              <tr class="border-b border-gray-100">
                <td class="py-1 px-1 align-middle">
                  <span
                    class="inline-flex items-center justify-center w-4 h-4 rounded text-[10px] font-bold"
                    style={`background-color: ${color?.hex ?? "#999"}; color: ${color?.textHex ?? "#fff"};${v.racer.boatNumber === 1 ? " border: 1px solid #cbd5e1;" : ""}`}
                  >
                    {v.racer.boatNumber}
                  </span>
                </td>
                <td class="py-1 px-1 align-middle">
                  <a
                    href={`#boat-${v.racer.boatNumber}`}
                    class="text-[12px] font-medium text-blue-700 hover:underline"
                  >
                    {v.racer.racerName}
                  </a>
                  <span class="block text-[10px] text-gray-400">{v.racer.classGrade}</span>
                </td>
                <td
                  class={`py-1 px-1 text-right align-middle font-mono tabular-nums ${shifted ? "font-bold text-amber-700" : "text-gray-500"}`}
                >
                  {v.entryCourse}
                </td>
                {basis !== undefined && (
                  <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-500">
                    {num(v.rawRate, 3)}
                  </td>
                )}
                <td class="py-1 px-1 align-middle">
                  <span class="flex items-center gap-1.5">
                    <span class="flex-1 h-3 bg-gray-100 rounded overflow-hidden min-w-6">
                      <span
                        class="block h-full bg-blue-500"
                        style={`width: ${widthPct}%`}
                        aria-hidden="true"
                      />
                    </span>
                    <span class="font-mono tabular-nums text-gray-800 w-9 text-right">
                      {num(v.wakuPt, 1)}
                    </span>
                    {rank !== undefined && (
                      <span
                        class={`w-5 text-[10px] text-right ${rank === 1 ? "font-bold text-blue-700" : "text-gray-400"}`}
                      >
                        {rank}位
                      </span>
                    )}
                  </span>
                </td>
                <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-800">
                  {num(v.contribution, 2)}
                </td>
                <td class="py-1 px-1 text-right align-middle font-mono tabular-nums text-gray-500">
                  {v.strengthPt.toFixed(2)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="text-[11px] text-gray-400 mt-2">
      枠番ptは偏差値スケール（この場の平均が50、標準偏差が10）。寄与 = 場別重み × 枠番pt で、
      強さptはこの寄与を含む5成分の合計です。
      「進入」は
      {courseFromExhibition ? "スタート展示の実測進入コース" : "枠なり進入を仮置きした値（スタート展示が未取得）"}。
      評価は
      <span class="font-mono">{evaluation.state === "realtime" ? "直前情報反映後" : "朝バッチ時点"}</span>
      のもの（枠番pt自体は直前情報では変わりません。動くのは進入コースが変わったときだけ）。
    </p>
  </section>

  {/* 枠ごとの内訳 */}
  <div class="space-y-4 mb-6">
    {views.map((v) => (
      <WakuPtCard
        racer={v.racer}
        wakuPt={v.wakuPt}
        contribution={v.contribution}
        strengthPt={v.strengthPt}
        entryCourse={v.entryCourse}
        entryCourseFromExhibition={courseFromExhibition}
        basis={basis}
      />
    ))}
  </div>

  {/* 選手個人の成績はここには無い、という導線 */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <h2 class="font-bold text-base mb-1">選手個人の枠番成績を見たいとき</h2>
    <p class="text-[13px] text-gray-700">
      このページの数字には<span class="font-bold">選手個人の成績が一切入っていません</span>。
      「この選手がこの枠でどう走ってきたか」は別の指標なので、レース詳細ページの
      <a href={`${raceHref}#waku10`} class="text-blue-600 hover:underline">枠番別過去10走</a>
      を参照してください。選手の巧拙そのものは
      <a href={`${raceHref}racers/`} class="text-blue-600 hover:underline">選手pt</a>
      が担当します。
    </p>
  </section>

  {/* 計算ロジックの解説 */}
  <section class="bg-white rounded-lg shadow-sm p-4 mb-6">
    <details>
      <summary class="font-bold text-lg cursor-pointer">枠番ptの計算ロジック</summary>

      <div class="mt-3 space-y-4 text-sm text-gray-700">
        <div>
          <h3 class="font-bold text-sm mb-1">2段階で決まる</h3>
          <ol class="list-decimal list-inside space-y-1 text-[13px]">
            <li>
              <span class="font-bold">枠番pt</span> =
              {" "}{WAKU_PT_TABLE_AXES.join(" × ")}
              {" "}別のコース強度テーブルを、その艇のコースで引いた値。
              場内の平均 μ と標準偏差 σ で偏差値スケール（50 + 10 × z）に直してある
            </li>
            <li>
              <span class="font-bold">寄与</span> = 場別重み w × 枠番pt。
              5成分の寄与を合計したものが強さptになります（重みの合計は 1）
            </li>
          </ol>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">入力の出どころ</h3>
          <ul class="space-y-1 text-[13px]">
            <li>
              <span class="font-bold">コース強度テーブル</span> —
              <span class="font-mono">estimate/stadium/win_rate.csv</span>。
              24場 × 4季節 × 6コースの長期勝率で、その場の過去数年ぶんの着順実績から作られた
              据え置きの静的テーブルです
            </li>
            <li>
              <span class="font-bold">μ / σ / 重み w</span> —
              <span class="font-mono">estimate/stadium/weights/{basis?.predictorId ?? "{予想者}"}/</span>。
              直近6ヶ月のデータから場別・月次で学習されます
              {basis && `（このページは ${basis.weightsMonth} 版）`}
            </li>
          </ul>
          <p class="text-[13px] mt-1">
            この2つを取り込んでいるので、各カードの「計算過程」は
            <span class="font-bold">表示している枠番ptそのものを再現した値</span>です
            （丸めの都合で小数第2位まで一致します）。
          </p>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">選手ptやモーターptと違うところ</h3>
          <ul class="space-y-1 text-[13px]">
            <li>
              <span class="font-bold">選手個人を見ていない</span> —
              同じ場・同じ季節・同じコースなら、誰が乗っていても枠番ptは同じ値です。
              選手の巧拙は選手pt、モーターの出来はモーターptが担当します
            </li>
            <li>
              <span class="font-bold">レース間でほとんど動かない</span> —
              テーブルの軸に日付やレース番号が入っていないので、同じ場の同じ日なら
              全レースで同じ枠番ptになります（動くのは進入コースが変わったときと、
              季節が替わったとき、場が違うとき）
            </li>
            <li>
              <span class="font-bold">場ごとの差が大きい</span> —
              イン有利な場とそうでない場では1コースの勝率が2点以上開きます。
              枠番ptはこの差を場別の偏差値に直したもので、寄与に効く重み w も場別に学習されます
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">枠番と進入コースのずれ</h3>
          <p class="text-[13px]">
            枠番ptが引くのは<span class="font-bold">コース</span>の強度です。枠なり進入なら
            枠番＝コースですが、前付けがあると両者はずれます（1号艇の1コース取得率は全国で約98%）。
            スタート展示（<span class="font-mono">previews/stt</span>）を取得すると
            <span class="font-mono">realtime</span> 側は実際の進入コースで引き直され、
            未取得の <span class="font-mono">daily</span> 側は枠なり進入で仮置きされます。
            {hasCourseShift
              ? "このレースは枠番と進入コースが違う艇があるので、一覧の「進入」列を確認してください。"
              : "このレースは全艇が枠なり進入（枠番＝コース）です。"}
          </p>
        </div>

        <div>
          <h3 class="font-bold text-sm mb-1">コースptとの違い（退役予想者）</h3>
          <p class="text-[13px]">
            2026-07-22 に投入した <span class="font-mono">v6_course</span>（コース予想）は、
            枠番ptを<span class="font-bold">場 × レース番号 × コース</span>別の収縮済み1着率
            （コースpt）に差し替えた実験でした。企画レースの多い場でレース番号ごとの傾向を
            拾う狙いでしたが、本命予想とのペア比較で回収率が有意に低く、
            2026-08-09 に <span class="font-mono">v7_aggregate</span> /
            <span class="font-mono">v8_aionly</span> と併せて退役しています。
            現行 active の予想者はいずれも枠番pt（場 × 季節 × コース）を使います。
          </p>
        </div>

        <p class="text-[11px] text-gray-500">
          データと計算式の一次情報は
          <a
            href="https://github.com/BoatraceCSV/boatracecsv.github.io"
            class="text-blue-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer">BoatraceCSV</a
          >を参照してください。
        </p>
      </div>
    </details>
  </section>

  <div class="text-center mt-6">
    <a href={raceHref} class="text-blue-600 hover:text-blue-800 text-sm">
      ← {stadiumName} {prediction.raceNumber}R に戻る
    </a>
  </div>
</BaseLayout>
